<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseRidGraph Condition="'$(RuntimeIdentifier)' == 'ubuntu.22.04-x64'">true</UseRidGraph>
    <NuGetLockFilePath Condition="'$(DeploySharpPaddleOcrCuda12)' == 'true'">$(MSBuildProjectDirectory)/packages.cuda12.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'linux-x64' And '$(RuntimeIdentifier)' != 'ubuntu.22.04-x64' And !$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="JYPPX.OpenCV.runtime.win-x64" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" />
    <PackageReference Include="OpenVINO.runtime.win" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'ubuntu.22.04-x64' Or $([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="JYPPX.OpenCV.runtime.ubuntu.22.04-x64" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Linux" />
    <PackageReference Include="OpenVINO.runtime.ubuntu.22-x86_64" />
    <PackageReference Include="JYPPX.TensorRT.CSharp.API.Runtime.linux-x64.ubuntu22.04.trt11.0.cuda12.9.cudnn9.22.Bridge" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DeploySharp.Backend.OnnxRuntime/DeploySharp.Backend.OnnxRuntime.csproj" />
    <ProjectReference Include="../../src/DeploySharp.Backend.OpenCV/DeploySharp.Backend.OpenCV.csproj" />
    <ProjectReference Include="../../src/DeploySharp.Backend.OpenVINO/DeploySharp.Backend.OpenVINO.csproj" />
    <ProjectReference Include="../../src/DeploySharp.Backend.TensorRT/DeploySharp.Backend.TensorRT.csproj" />
    <ProjectReference Include="../../src/DeploySharp.Visual/DeploySharp.Visual.csproj" />
    <ProjectReference Include="../../src/DeploySharp.Visual.OpenCV/DeploySharp.Visual.OpenCV.csproj" />
    <ProjectReference Include="../../src/DeploySharp.Visual.TensorRT/DeploySharp.Visual.TensorRT.csproj" />
  </ItemGroup>
</Project>
