<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Formula CUDA evidence is an explicit opt-in restore variant. The
         default solution/test graph remains on the repository CPU ORT line. -->
    <DeploySharpFormulaOrtCuda Condition="'$(DeploySharpFormulaOrtCuda)' == ''">false</DeploySharpFormulaOrtCuda>
    <DeploySharpPaddleOcrCuda12 Condition="'$(DeploySharpFormulaOrtCuda)' == 'true'">true</DeploySharpPaddleOcrCuda12>
    <CentralPackageTransitivePinningEnabled Condition="'$(DeploySharpFormulaOrtCuda)' == 'true'">false</CentralPackageTransitivePinningEnabled>
    <NuGetLockFilePath Condition="'$(DeploySharpFormulaOrtCuda)' == 'true'">$(MSBuildProjectDirectory)\packages.formula-cuda.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="JYPPX.OpenCV.runtime.win-x64" />
    <PackageReference Include="OpenVINO.runtime.win" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Condition="'$(DeploySharpFormulaOrtCuda)' != 'true'" />
    <!-- ORT 1.23.2 is the CUDA 12.x line used by the local Windows GPU
         runtime. It is never selected by the default CPU test restore. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" VersionOverride="1.23.2" NoWarn="NU1605" Condition="'$(DeploySharpFormulaOrtCuda)' == 'true'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" VersionOverride="1.23.2" NoWarn="NU1605" Condition="'$(DeploySharpFormulaOrtCuda)' == 'true'" />
    <PackageReference Include="OnnxSharp" />
    <PackageReference Include="JYPPX.TensorRT.CSharp.API" />
    <PackageReference Include="JYPPX.TensorRT.CSharp.API.Runtime.win-x64.trt10.11.cuda12.9.cudnn9.22.Bridge" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeploySharp.Visual.OpenCV\DeploySharp.Visual.OpenCV.csproj" />
    <ProjectReference Include="..\..\src\DeploySharp.Backend.OpenCV\DeploySharp.Backend.OpenCV.csproj" />
    <ProjectReference Include="..\..\src\DeploySharp.Backend.OpenVINO\DeploySharp.Backend.OpenVINO.csproj" />
    <ProjectReference Include="..\..\src\DeploySharp.Backend.OnnxRuntime\DeploySharp.Backend.OnnxRuntime.csproj" AdditionalProperties="DeploySharpPaddleOcrCuda12=$(DeploySharpFormulaOrtCuda)" />
    <ProjectReference Include="..\..\src\DeploySharp.Backend.TensorRT\DeploySharp.Backend.TensorRT.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\assets\opencv\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\assets\opencv\fixtures.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\assets\opencv\golden.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\assets\onnxruntime\**\*" Link="fixtures\onnx\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\assets\openvino\**\*" Link="fixtures\ir\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
