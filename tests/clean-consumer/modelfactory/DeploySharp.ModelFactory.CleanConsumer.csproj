<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).packages</RestorePackagesPath>
    <AssemblyName>DeploySharp.ModelFactory.CleanConsumer</AssemblyName>
    <RootNamespace>DeploySharp.ModelFactory.CleanConsumer</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JYPPX.DeploySharp.ModelFactory" Version="2.0.0-alpha.1" />
  </ItemGroup>
</Project>
