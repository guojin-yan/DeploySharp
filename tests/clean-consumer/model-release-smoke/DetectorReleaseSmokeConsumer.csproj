<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).packages</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JYPPX.DeploySharp.Core" Version="2.0.0-alpha.1" />
    <PackageReference Include="JYPPX.DeploySharp.ModelFactory" Version="2.0.0-alpha.1" />
    <PackageReference Include="JYPPX.DeploySharp.Visual" Version="2.0.0-alpha.1" />
    <PackageReference Include="JYPPX.DeploySharp.Visual.OpenCV" Version="2.0.0-alpha.1" />
    <PackageReference Include="JYPPX.DeploySharp.Backend.OnnxRuntime" Version="2.0.0-alpha.1" />
    <PackageReference Include="JYPPX.DeploySharp.Backend.OpenVINO" Version="2.0.0-alpha.1" />
    <PackageReference Include="JYPPX.OpenCV.runtime.win-x64" Version="5.0.0-preview.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
    <PackageReference Include="OpenVINO.runtime.win" Version="2026.2.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\assets\opencv\rgb.png" Link="assets\rgb.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
