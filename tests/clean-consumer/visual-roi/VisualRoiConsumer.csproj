<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)..\..\..\artifacts\roi-consumer-packages</RestorePackagesPath>
    <IsPackable>false</IsPackable>
    <DeploySharpRoiPackageVersion Condition="'$(DeploySharpRoiPackageVersion)' == ''">2.0.0-roi-smoke</DeploySharpRoiPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JYPPX.DeploySharp.Visual" Version="$(DeploySharpRoiPackageVersion)" />
    <Compile Include="..\..\..\samples\02-visual\roi-workflow\Program.cs" Link="Program.cs" />
  </ItemGroup>
</Project>
