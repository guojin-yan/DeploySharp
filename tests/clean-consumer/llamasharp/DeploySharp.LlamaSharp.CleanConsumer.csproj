<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <AssemblyName>DeploySharp.LlamaSharp.CleanConsumer</AssemblyName>
    <RootNamespace>DeploySharp.LlamaSharp.CleanConsumer</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JYPPX.DeploySharp.LLM" Version="2.0.0-alpha.1" />
    <PackageReference Include="JYPPX.DeploySharp.Backend.LlamaSharp" Version="2.0.0-alpha.1" />
    <!-- The consumer, not DeploySharp, selects and owns the native package. / 原生包由使用者选择和持有，而不是 DeploySharp。 -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
  </ItemGroup>
</Project>
