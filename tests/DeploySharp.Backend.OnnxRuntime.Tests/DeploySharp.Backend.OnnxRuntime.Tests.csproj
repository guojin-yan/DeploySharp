<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <!-- Tests, not the adapter package, opt in to the official CPU native runtime. / 测试项目而非适配器包选择官方 CPU 原生运行时。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeploySharp.Backend.OnnxRuntime\DeploySharp.Backend.OnnxRuntime.csproj" />
    <ProjectReference Include="..\..\src\DeploySharp.Visual\DeploySharp.Visual.csproj" />
    <ProjectReference Include="..\..\src\DeploySharp.ModelPack.Json\DeploySharp.ModelPack.Json.csproj" />
    <ProjectReference Include="..\..\src\DeploySharp.ModelFactory\DeploySharp.ModelFactory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\assets\onnxruntime\**\*" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
