<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- PaddleOCR-VL CUDA evidence is an explicit opt-in restore variant.
         The default test graph remains on the repository CPU ORT line. -->
    <DeploySharpPaddleOcrCuda12 Condition="'$(DeploySharpPaddleOcrCuda12)' == ''">false</DeploySharpPaddleOcrCuda12>
    <CentralPackageTransitivePinningEnabled Condition="'$(DeploySharpPaddleOcrCuda12)' == 'true'">false</CentralPackageTransitivePinningEnabled>
    <NuGetLockFilePath Condition="'$(DeploySharpPaddleOcrCuda12)' == 'true'">$(MSBuildProjectDirectory)\packages.cuda12.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <!-- Tests, not the adapter package, select the native runtime. The CUDA
         variant is never selected by the default CPU restore. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Condition="'$(DeploySharpPaddleOcrCuda12)' != 'true'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" VersionOverride="1.23.2" NoWarn="NU1605" Condition="'$(DeploySharpPaddleOcrCuda12)' == 'true'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" VersionOverride="1.23.2" NoWarn="NU1605" Condition="'$(DeploySharpPaddleOcrCuda12)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeploySharp.Backend.OnnxRuntime\DeploySharp.Backend.OnnxRuntime.csproj" AdditionalProperties="DeploySharpPaddleOcrCuda12=$(DeploySharpPaddleOcrCuda12)" />
    <ProjectReference Include="..\..\src\DeploySharp.Visual\DeploySharp.Visual.csproj" />
    <ProjectReference Include="..\..\src\DeploySharp.ModelPack.Json\DeploySharp.ModelPack.Json.csproj" />
    <ProjectReference Include="..\..\src\DeploySharp.ModelFactory\DeploySharp.ModelFactory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\assets\onnxruntime\**\*" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
