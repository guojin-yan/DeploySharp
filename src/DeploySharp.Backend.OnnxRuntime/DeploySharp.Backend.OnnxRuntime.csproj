<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- ONNX Runtime Managed 1.28.0 is the repository default. CUDA 12.x
         PaddleOCR applications opt into the matching 1.23.2 line at restore. -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <!-- The CUDA 12 application graph is an opt-in restore variant. Keep its
         lock separate so restoring a PaddleOCR app never rewrites the
         library's checked-in default (1.28.0) graph. -->
    <NuGetLockFilePath Condition="'$(DeploySharpPaddleOcrCuda12)' == 'true'">$(MSBuildProjectDirectory)\packages.cuda12.lock.json</NuGetLockFilePath>
    <AssemblyName>JYPPX.DeploySharp.Backend.OnnxRuntime</AssemblyName>
    <RootNamespace>JYPPX.DeploySharp.Backends.OnnxRuntime</RootNamespace>
    <PackageId>JYPPX.DeploySharp.Backend.OnnxRuntime</PackageId>
    <Title>DeploySharp ONNX Runtime Backend</Title>
    <Description>Managed ONNX Runtime adapter for named-tensor DeploySharp inference without bundling a native execution provider.</Description>
    <PackageTags>DeploySharp;ONNX;ONNXRuntime;Inference;Tensor;AI;CSharp</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeploySharp.Core\DeploySharp.Core.csproj" />
    <ProjectReference Include="..\DeploySharp.Extensibility\DeploySharp.Extensibility.csproj" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Condition="'$(DeploySharpPaddleOcrCuda12)' != 'true'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" VersionOverride="1.23.2" Condition="'$(DeploySharpPaddleOcrCuda12)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
