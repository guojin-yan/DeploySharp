{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guojin-yan.github.io/DeploySharp/schemas/deploysharp-model-catalog-1.0.schema.json",
  "title": "DeploySharp Model Catalog 1.0",
  "description": "Audited model and test-asset references owned by immutable GitHub Releases.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "catalogRevision", "sourceRepository", "entries"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "catalogRevision": { "$ref": "#/$defs/identifier" },
    "sourceRepository": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
    "entries": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[a-z0-9._/-]+$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 32768, "pattern": "^(?![\\\\/])(?!.*(^|[\\\\/])\\.?\\.?([\\\\/]|$))(?!.*:).+$" },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceUrl", "revision", "author", "redistributionAllowed"],
      "properties": {
        "sourceUrl": { "type": "string", "format": "uri" },
        "projectUrl": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "author": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "copyright": { "type": "string", "maxLength": 4096 },
        "licenseExpression": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "licenseFile": { "$ref": "#/$defs/relativePath" },
        "redistributionAllowed": { "type": "boolean" }
      },
      "anyOf": [{ "required": ["licenseExpression"] }, { "required": ["licenseFile"] }]
    },
    "release": {
      "type": "object", "additionalProperties": false, "required": ["owner", "repository", "tag", "commit"],
      "properties": {
        "owner": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "tag": { "type": "string", "pattern": "^models-[0-9]{8}\\.[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "commit": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["assetId", "kind", "releaseTag", "downloadUrl", "relativePath", "size", "sha256"],
      "properties": {
        "assetId": { "$ref": "#/$defs/identifier" },
        "kind": { "type": "string", "enum": ["manifest", "model", "testInput", "testExpected", "license", "other"] },
        "releaseTag": { "type": "string", "pattern": "^models-[0-9]{8}\\.[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "downloadUrl": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/.+/releases/download/.+/.+" },
        "relativePath": { "$ref": "#/$defs/relativePath" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaType": { "type": "string", "maxLength": 4096 },
        "licenseExpression": { "type": "string", "maxLength": 4096 }
      }
    },
    "conversion": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "exporter": { "type": "string", "maxLength": 4096 },
        "exporterVersion": { "type": "string", "maxLength": 4096 },
        "sourceRevision": { "type": "string", "maxLength": 4096 },
        "notes": { "type": "string", "maxLength": 4096 }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactId", "format", "compatibleBackends", "portable", "assets"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/identifier" },
        "format": { "$ref": "#/$defs/identifier" },
        "compatibleBackends": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "precision": { "$ref": "#/$defs/identifier" },
        "quantization": { "$ref": "#/$defs/identifier" },
        "portable": { "type": "boolean" },
        "manifestAssetId": { "$ref": "#/$defs/identifier" },
        "bundleRole": { "$ref": "#/$defs/identifier" },
        "bundleVersion": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "requiredAssetIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "tokenizerId": { "$ref": "#/$defs/identifier" },
        "vocabularyMode": { "$ref": "#/$defs/identifier" },
        "embeddingDimension": { "type": "integer", "minimum": 1 },
        "imagePreprocessingId": { "$ref": "#/$defs/identifier" },
        "projectionId": { "$ref": "#/$defs/identifier" },
        "normalizationId": { "$ref": "#/$defs/identifier" },
        "scoreSemantics": { "$ref": "#/$defs/identifier" },
        "language": { "$ref": "#/$defs/identifier" },
        "resolution": { "$ref": "#/$defs/identifier" },
        "visionBackbone": { "$ref": "#/$defs/identifier" },
        "qFormerId": { "$ref": "#/$defs/identifier" },
        "languageModelId": { "$ref": "#/$defs/identifier" },
        "promptTemplateId": { "$ref": "#/$defs/identifier" },
        "generationConfigId": { "$ref": "#/$defs/identifier" },
        "generationMode": { "$ref": "#/$defs/identifier" },
        "kvCacheSchemaId": { "$ref": "#/$defs/identifier" },
        "imageCount": { "type": "integer", "minimum": 1 },
        "contextLength": { "type": "integer", "minimum": 1 },
        "pageCount": { "type": "integer", "minimum": 1 },
        "schemaId": { "$ref": "#/$defs/identifier" },
        "ocrOwnership": { "enum": ["caller", "processor", "ocr-free"] },
        "processorId": { "$ref": "#/$defs/identifier" },
        "sampleRate": { "type": "integer", "minimum": 1 },
        "channelCount": { "type": "integer", "minimum": 1 },
        "timestampMode": { "$ref": "#/$defs/identifier" },
        "speakerMode": { "$ref": "#/$defs/identifier" },
        "audioFeatureId": { "$ref": "#/$defs/identifier" },
        "vadId": { "$ref": "#/$defs/identifier" },
        "speakerId": { "$ref": "#/$defs/identifier" },
        "assets": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/asset" } },
        "conversion": { "$ref": "#/$defs/conversion" }
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["modelId", "name", "family", "task", "modelVersion", "status", "source", "artifacts", "testInputs"],
      "properties": {
        "modelId": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "family": { "$ref": "#/$defs/identifier" },
        "task": { "$ref": "#/$defs/identifier" },
        "modelVersion": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "status": { "type": "string", "enum": ["supported", "preview", "external"] },
        "description": { "type": "string", "maxLength": 4096 },
        "source": { "$ref": "#/$defs/source" },
        "release": { "$ref": "#/$defs/release" },
        "artifacts": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/artifact" } },
        "testInputs": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
        "expectedResultAssetId": { "$ref": "#/$defs/identifier" },
        "documentationPath": { "$ref": "#/$defs/relativePath" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "supported" } }, "required": ["status"] },
          "then": {
            "required": ["release", "expectedResultAssetId", "documentationPath"],
            "properties": {
              "testInputs": {
                "contains": {
                  "type": "object",
                  "properties": { "kind": { "const": "testInput" } },
                  "required": ["kind"]
                },
                "minContains": 1
              }
            }
          }
        }
      ]
    }
  }
}
