<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <AssemblyName>JYPPX.DeploySharp.Visual.TensorRT</AssemblyName>
    <RootNamespace>JYPPX.DeploySharp.Visual.TensorRT</RootNamespace>
    <PackageId>JYPPX.DeploySharp.Visual.TensorRT</PackageId>
    <Title>DeploySharp Visual TensorRT</Title>
    <Description>CUDA preprocessing and TensorRT visual inference for classification, detection, segmentation, pose, OBB, anomaly, matting, and PaddleOCR-VL device-resident decoding.</Description>
    <PackageTags>DeploySharp;Visual;TensorRT;CUDA;GPU;Preprocessing;Inference;PaddleOCR-VL;CSharp</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeploySharp.Backend.TensorRT\DeploySharp.Backend.TensorRT.csproj" />
    <ProjectReference Include="..\DeploySharp.Visual\DeploySharp.Visual.csproj" />
    <ProjectReference Include="..\DeploySharp.Visual.OpenCV\DeploySharp.Visual.OpenCV.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
