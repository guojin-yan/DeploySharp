<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net46;net461;net462;net47;net471;net472;net48;net481;netcoreapp3.1;net5.0;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>JYPPX.DeploySharp.Backend.OpenCV</AssemblyName>
    <RootNamespace>JYPPX.DeploySharp.Backends.OpenCV</RootNamespace>
    <PackageId>JYPPX.DeploySharp.Backend.OpenCV</PackageId>
    <Title>DeploySharp OpenCV DNN Backend</Title>
    <Description>OpenCV DNN CPU adapter for explicit named vision tensor contracts with runtime shape specialization, without bundling a native runtime.</Description>
    <PackageTags>DeploySharp;OpenCV;DNN;ONNX;Vision;Inference;Tensor;AI;CSharp</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DeploySharp.Core\DeploySharp.Core.csproj" />
    <ProjectReference Include="..\DeploySharp.Extensibility\DeploySharp.Extensibility.csproj" />
    <PackageReference Include="JYPPX.OpenCV.CSharp.API" />
    <PackageReference Include="OnnxSharp" Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0' Or '$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="OpenCvDnnOnnxCompatibilityPasses.cs" />
    <Compile Include="OpenCvDnnOnnxCompatibilityPasses.cs" Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0' Or '$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
