<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(DeploySharpLibraryTargetFrameworks)</TargetFrameworks>
    <AssemblyName>JYPPX.DeploySharp.Visual</AssemblyName>
    <RootNamespace>JYPPX.DeploySharp.Visual</RootNamespace>
    <PackageId>JYPPX.DeploySharp.Visual</PackageId>
    <Title>DeploySharp Visual</Title>
    <Description>Image-library-neutral prepared-tensor pipelines, profiles, classification, detection, semantic segmentation, geometry mapping, RLE, and NMS for DeploySharp.</Description>
    <PackageTags>DeploySharp;Visual;Classification;Detection;SemanticSegmentation;RLE;NMS;Tensor;AI;CSharp</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeploySharp.Core\DeploySharp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
