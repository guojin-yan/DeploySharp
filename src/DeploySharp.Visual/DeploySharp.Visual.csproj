<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(DeploySharpLibraryTargetFrameworks)</TargetFrameworks>
    <AssemblyName>JYPPX.DeploySharp.Visual</AssemblyName>
    <RootNamespace>JYPPX.DeploySharp.Visual</RootNamespace>
    <PackageId>JYPPX.DeploySharp.Visual</PackageId>
    <Title>DeploySharp Visual</Title>
    <Description>Image-library-neutral prepared-tensor pipelines, profiles, classification, detection, anomaly maps, OCR, OBB, semantic and instance segmentation, Pose estimation, geometry mapping, polygon IoU, CTC, RLE, NMS, and OKS for DeploySharp.</Description>
    <PackageTags>DeploySharp;Visual;Classification;Detection;AnomalyDetection;AnomalySegmentation;AnomalyMap;OCR;TextDetection;TextRecognition;CTC;PerspectiveCrop;OBB;OrientedDetection;RotatedNMS;PolygonIoU;SemanticSegmentation;InstanceSegmentation;PrototypeMasks;Pose;Keypoints;OKS;RLE;NMS;Tensor;AI;CSharp</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <DefineConstants Condition="'$(TargetFramework)' == 'net46' Or '$(TargetFramework)' == 'net461'">$(DefineConstants);DEPLOYSHARP_LEGACY_NO_ROI</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeploySharp.Core\DeploySharp.Core.csproj" />
    <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' != 'net46' And '$(TargetFramework)' != 'net461'" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0' Or '$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <!-- System.Text.Json 10 does not ship a net46/net461 asset. Keep JSON excluded on those
       legacy targets. net46 also predates the ValueTuple reference used by the ROI runner;
       the legacy target retains the pre-ROI Visual surface. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net46' Or '$(TargetFramework)' == 'net461'">
    <Compile Remove="Configuration\Json\**" />
    <Compile Remove="Roi\**" />
    <Compile Remove="Detection\SlidingWindowDetection.cs" />
    <Compile Remove="Models\PaddleOcr\Document\PaddleDocumentPipelineExport.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
