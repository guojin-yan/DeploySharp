{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guojin-yan.github.io/DeploySharp/schemas/deploysharp-model-package-2.0.schema.json",
  "title": "DeploySharp Model Package 2.0",
  "description": "Portable metadata and integrity records for one DeploySharp model package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modelId",
    "name",
    "family",
    "task",
    "modelVersion",
    "exporter",
    "source",
    "inputs",
    "outputs",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^2\\.[0-9]+$" },
    "modelId": { "$ref": "#/$defs/identifier" },
    "name": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "family": { "$ref": "#/$defs/identifier" },
    "task": { "$ref": "#/$defs/identifier" },
    "modelVersion": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "exporter": { "$ref": "#/$defs/exporter" },
    "source": { "$ref": "#/$defs/source" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "profileId": { "$ref": "#/$defs/identifier" },
    "inputs": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/tensor" } },
    "outputs": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/tensor" } },
    "artifacts": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/artifact" } },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[a-z0-9._/-]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768,
      "pattern": "^(?![\\\\/])(?!.*(^|[\\\\/])\\.\\.?([\\\\/]|$))(?!.*:).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "extensions": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "type": "string", "maxLength": 4096 }
    },
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "version": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sourceRevision": { "type": "string", "maxLength": 4096 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceUrl", "revision", "author", "redistributionAllowed"],
      "properties": {
        "sourceUrl": { "type": "string", "format": "uri", "maxLength": 4096 },
        "projectUrl": { "type": "string", "format": "uri", "maxLength": 4096 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "author": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "copyright": { "type": "string", "maxLength": 4096 },
        "licenseExpression": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "licenseFile": { "$ref": "#/$defs/relativePath" },
        "redistributionAllowed": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["licenseExpression"] },
        { "required": ["licenseFile"] }
      ]
    },
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "elementType", "shape"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "elementType": { "$ref": "#/$defs/identifier" },
        "shape": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "anyOf": [
              { "const": -1 },
              { "type": "integer", "minimum": 1 }
            ]
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "format", "locationKind", "entrypoint", "compatibleBackends", "files", "portable"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/identifier" },
        "format": { "$ref": "#/$defs/identifier" },
        "locationKind": { "type": "string", "enum": ["file", "directory"] },
        "entrypoint": { "$ref": "#/$defs/relativePath" },
        "compatibleBackends": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "files": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/file" } },
        "precision": { "$ref": "#/$defs/identifier" },
        "quantization": { "$ref": "#/$defs/identifier" },
        "opset": { "type": "integer", "minimum": 1 },
        "portable": { "type": "boolean" },
        "minimumBackendVersion": { "type": "string", "maxLength": 4096 },
        "minimumRuntimeVersion": { "type": "string", "maxLength": 4096 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256", "size", "role"],
      "properties": {
        "relativePath": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 },
        "mediaType": { "type": "string", "maxLength": 4096 },
        "role": {
          "type": "string",
          "enum": ["model", "weights", "externalData", "labels", "vocabulary", "tokenizer", "chatTemplate", "configuration", "license", "testInput", "other"]
        }
      }
    }
  }
}
