<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DeploySharp.Visual\DeploySharp.Visual.csproj" />
  </ItemGroup>
  <!-- Nested samples are independent executables. Without an explicit removal,
       SDK default globs also compile their Program.cs and generated obj files. -->
  <ItemGroup>
    <Compile Remove="roi-workflow\**" />
    <Compile Remove="roi-official-sam\**" />
    <Compile Remove="paddleocr-vl-onnx\**" />
    <Compile Remove="paddleocr-vl-document\**" />
    <EmbeddedResource Remove="roi-workflow\**" />
    <EmbeddedResource Remove="roi-official-sam\**" />
    <EmbeddedResource Remove="paddleocr-vl-onnx\**" />
    <EmbeddedResource Remove="paddleocr-vl-document\**" />
    <None Remove="roi-workflow\**" />
    <None Remove="roi-official-sam\**" />
    <None Remove="paddleocr-vl-onnx\**" />
    <None Remove="paddleocr-vl-document\**" />
  </ItemGroup>
</Project>
