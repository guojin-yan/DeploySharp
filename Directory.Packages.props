<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.3.3" />
    <PackageVersion Include="LLamaSharp" Version="0.27.0" />
    <PackageVersion Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.10" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.28.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" Version="1.28.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Gpu.Linux" Version="1.28.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="JYPPX.OpenVINO.CSharp.API" Version="3.3.1" />
    <PackageVersion Include="JYPPX.TensorRT.CSharp.API" Version="4.0.0" />
    <!-- NuGet currently publishes the Windows TensorRT 10 bridge for the 10.11/12.9/9.22 line. Keep vendor CUDA/TensorRT DLLs consumer-owned. -->
    <PackageVersion Include="JYPPX.TensorRT.CSharp.API.Runtime.win-x64.trt10.11.cuda12.9.cudnn9.22.Bridge" Version="4.0.0" />
    <PackageVersion Include="JYPPX.TensorRT.CSharp.API.Runtime.linux-x64.ubuntu22.04.trt11.0.cuda12.9.cudnn9.22.Bridge" Version="4.0.0" />
    <PackageVersion Include="OnnxSharp" Version="0.3.2" />
    <PackageVersion Include="JYPPX.OpenCV.CSharp.API" Version="5.0.0" />
    <PackageVersion Include="JYPPX.OpenCV.runtime.win-x64" Version="5.0.0" />
    <PackageVersion Include="JYPPX.OpenCV.runtime.ubuntu.22.04-x64" Version="5.0.0" />
    <PackageVersion Include="OpenVINO.runtime.win" Version="2026.2.1" />
    <PackageVersion Include="OpenVINO.runtime.ubuntu.22-x86_64" Version="2026.3.1" />
    <PackageVersion Include="System.Text.Json" Version="10.0.10" />
  </ItemGroup>

  <!-- CUDA 12.x applications (the PaddleOCR demo/benchmark) opt into the
       matching ORT 1.23.2 line at restore/publish time with
       -p:DeploySharpPaddleOcrCuda12=true. The default library graph remains
       on ORT 1.28.0 for existing consumers. -->
  <ItemGroup Condition="'$(DeploySharpPaddleOcrCuda12)' == 'true'">
    <PackageVersion Update="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
    <PackageVersion Update="Microsoft.ML.OnnxRuntime.Managed" Version="1.23.2" />
    <PackageVersion Update="Microsoft.ML.OnnxRuntime.Gpu.Windows" Version="1.23.2" />
    <PackageVersion Update="Microsoft.ML.OnnxRuntime.Gpu.Linux" Version="1.23.2" />
  </ItemGroup>

</Project>
