<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>DeploySharpApp.BackendHost</AssemblyName>
    <RootNamespace>DeploySharpApp.BackendHost</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DeploySharpApp.Contracts\DeploySharpApp.Contracts.csproj" />
    <ProjectReference Include="..\DeploySharpApp.Plugin.Abstractions\DeploySharpApp.Plugin.Abstractions.csproj" />
    <ProjectReference Include="..\DeploySharpApp.BackendHost.Protocol\DeploySharpApp.BackendHost.Protocol.csproj" />
    <!-- Native-capable adapters are referenced by the isolated net10 Worker only. The web and net48 hosts do not load them. -->
    <PackageReference Include="JYPPX.DeploySharp.Backend.LlamaSharp" />
    <PackageReference Include="JYPPX.DeploySharp.Backend.OnnxRuntime" />
    <PackageReference Include="JYPPX.DeploySharp.Backend.OpenCV" />
    <PackageReference Include="JYPPX.DeploySharp.Backend.OpenVINO" />
    <PackageReference Include="JYPPX.DeploySharp.Backend.TensorRT" />
    <!-- Project-owned bridge only; CUDA/cuDNN/TensorRT vendor runtimes remain user-installed. -->
    <PackageReference Include="JYPPX.TensorRT.CSharp.API.Runtime.win-x64.trt10.11.cuda12.9.cudnn9.22.Bridge" RuntimeIdentifier="win-x64" />
    <PackageReference Include="JYPPX.DeploySharp.Core" />
    <PackageReference Include="JYPPX.DeploySharp.Extensibility" />
    <PackageReference Include="JYPPX.DeploySharp.LLM" />
    <PackageReference Include="JYPPX.DeploySharp.Visual" />
    <PackageReference Include="JYPPX.DeploySharp.Visual.OpenCV" />
    <!-- Native runtime packages are intentionally copied only into the isolated Worker output. -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="JYPPX.OpenCV.runtime.win-x64" RuntimeIdentifier="win-x64" />
    <PackageReference Include="OpenVINO.runtime.win" RuntimeIdentifier="win-x64" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>
</Project>
