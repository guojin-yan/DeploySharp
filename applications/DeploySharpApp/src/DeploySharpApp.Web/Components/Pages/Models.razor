@page "/models"
@inject DeploySharpAppService Service
<PageTitle>模型与后端 · DeploySharpApp</PageTitle><h1>模型与后端</h1><p class="muted">页面由 manifest/catalog 驱动；安装和 native 探测失败只影响当前后端。</p><div class="cards">@foreach (var backend in Service.Backends) { <article class="card"><h2>@backend.DisplayName</h2><p>@backend.ProviderPackageId @backend.ProviderPackageVersion</p><p>能力：@backend.Capabilities · 格式：@string.Join(", ", backend.Formats)</p><span class="state @backend.State.ToString().ToLowerInvariant()">@backend.State</span><small>@(backend.Detail ?? "无诊断")</small></article> }</div><h2 class="section-title">模型目录</h2><div class="cards">@foreach (var model in Service.Models) { <article class="card"><h3>@model.DisplayName</h3><p>@model.Task · @model.Format · @model.Size</p><small>推荐：@string.Join(", ", model.RecommendedBackends) · @(model.Cached ? "已缓存" : "按需下载")</small></article> }</div>
