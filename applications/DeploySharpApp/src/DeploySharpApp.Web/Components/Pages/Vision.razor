    private string parameterModeLabel => selectedReleaseModel is null
        ? "通用默认 · 可编辑"
        : usingRecommendedParameters ? "模型推荐 · 可编辑" : "自定义覆盖 · 可编辑";
    private VisualReleaseModel? selectedReleaseModel => releaseModels.FirstOrDefault(model => string.Equals(model.Id, selectedModelId, StringComparison.OrdinalIgnoreCase));
    private VisualTestImage? selectedTestImage => testImages.FirstOrDefault(image => string.Equals(image.Id, selectedTestImageId, StringComparison.OrdinalIgnoreCase));
    private VisualTestImage? effectiveTestImage => selectedTestImage ?? (selectedReleaseModel is null ? null : TestImageCatalog.FindDefault(testImages, selectedReleaseModel.Task, selectedReleaseModel.DisplayName));
    private IReadOnlyList<ReadinessCheck> readinessChecks => BuildReadinessChecks();
    private string readinessHeadline => readinessChecks.All(check => check.Ready) ? (readinessChecks.Any(check => check.Attention) ? "可运行 · 有待处理项" : "可运行") : "需要处理";
    private bool IsWorkerVisionBackend => IsBackend("opencv") || IsBackend("openvino") || IsBackend("tensorrt");
    private bool UsesWorkerForCurrentVision => IsWorkerVisionBackend || selectedReleaseModel is not null;
    private string backendExecutionLabel => IsBackend("onnxruntime") ? (selectedReleaseModel is null ? "ONNX Runtime · CPU 进程内" : "ONNX Runtime · CPU Worker") : IsBackend("opencv") ? "OpenCV DNN · CPU Worker" : IsBackend("openvino") ? "OpenVINO · CPU Worker" : IsBackend("tensorrt") ? "TensorRT · CUDA Worker" : "后端待确认";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Task<IReadOnlyList<VisualReleaseModel>> modelsTask = ReleaseCatalog.GetModelsAsync(new Progress<double>(value => { catalogProgress = value; InvokeAsync(StateHasChanged); }));
        Task<IReadOnlyList<VisualTestImage>> imagesTask = TestImageCatalog.GetImagesAsync();
        try { releaseModels.AddRange(await modelsTask); }
        catch (Exception exception) { catalogError = exception.Message; }
        finally { catalogLoading = false; ApplyModelDefaults(); }
        try { testImages.AddRange(await imagesTask); }
        catch (Exception exception) { testImageError = exception.Message; }
        finally { testImageLoading = false; await InvokeAsync(StateHasChanged); }
    }

    private void HandleModelChanged(ChangeEventArgs args)
    {
        selectedModelId = args.Value?.ToString() ?? "demo/yolo-v8-n";
        // A catalog selection starts a new source; do not keep verified assets from a previous local bundle.
        modelPackMaterialization = null;
        factoryMaterialization = null;
        selectedFactoryModelId = string.Empty;
        factoryError = null;
        if (imageFromRelease) ClearImagePreview();
        selectedTestImageId = string.Empty;
        ApplyModelDefaults();
    }

    private void HandleFactoryModelChanged(ChangeEventArgs args)
    {
        selectedFactoryModelId = args.Value?.ToString() ?? string.Empty;
        factoryError = null;
    }

    private async Task MaterializeFactoryModelAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedFactoryModelId) || factoryMaterializing) return;
        factoryMaterializing = true; factoryProgress = 0; factoryError = null; factoryMaterialization = null; modelPackMaterialization = null;
        try
        {
            var progress = new Progress<JYPPX.DeploySharp.ModelFactory.ModelDownloadProgress>(value =>
            {
                factoryProgress = value.TotalBytes > 0 ? Math.Clamp((double)value.ReceivedBytes / value.TotalBytes, 0, 1) : value.Stage == JYPPX.DeploySharp.ModelFactory.ModelDownloadStage.Completed ? 1 : factoryProgress;
                InvokeAsync(StateHasChanged);
            });
            factoryMaterialization = await FactoryRuntime.MaterializeAsync(selectedFactoryModelId, progress);
            modelPath = factoryMaterialization.ModelPath;
            uploadedModelPath = null;
            uploadedModelSha256 = factoryMaterialization.Sha256 ?? string.Empty;
            modelFileName = Path.GetFileName(modelPath);
            // Keep the Core model id so the Worker can select the same dedicated profile as Release models.
            selectedModelId = factoryMaterialization.CoreModelId;
            factoryProgress = 1;
            usingRecommendedParameters = false;
        }
        catch (Exception exception) { factoryError = exception.Message; }
        finally { factoryMaterializing = false; }
    }

    private async Task ValidateModelPackAsync()
    {
        if (modelPackValidating || string.IsNullOrWhiteSpace(modelPackManifestPath)) return;
        modelPackValidating = true; modelPackError = null;
        try
        {
            ModelPackMaterialization validated = await ModelPackRuntime.ValidateAsync(modelPackManifestPath);
            modelPackMaterialization = validated;
            modelPath = validated.ModelPath;
            uploadedModelPath = null;
            uploadedModelSha256 = validated.Sha256 ?? string.Empty;
            modelFileName = Path.GetFileName(validated.ModelPath);
            selectedModelId = validated.ModelId;
            selectedFactoryModelId = string.Empty;
            factoryMaterialization = null;
            usingRecommendedParameters = false;
            runtimeMessage = "本地 ModelPack 已通过主库完整性校验，可以运行。";
            Activity.Add("modelpack", "Validated local ModelPack " + validated.ModelId, "DSAPP-MODELPACK-VALIDATED");
        }
        catch (Exception exception)
        {
            modelPackError = exception.Message;
            Activity.Add("modelpack", exception.Message, "DSAPP-MODELPACK-VALIDATION-FAILED");
        }
        finally { modelPackValidating = false; }
    }

    private void HandleTestImageChanged(ChangeEventArgs args)
    {
        selectedTestImageId = args.Value?.ToString() ?? string.Empty;
        ClearImagePreview();
    }

    private void ApplyCommonDefaults()
    {
        tensorName = "images";
        tensorShape = "1,3,640,640";
        outputTensorNames = string.Empty;
        outputTensorShapesJson = string.Empty;
        outputTensorElementTypesJson = string.Empty;
        resizeMode = "stretch";
        colorOrder = "rgb";
        imageScale = "0.0039215686";
        meanR = meanG = meanB = "0";
        stdR = stdG = stdB = "1";
        padValue = "0";
        maxConcurrency = "1";
        intraOpThreads = interOpThreads = "0";
        graphOptimization = "All";
        executionMode = "Sequential";
        logSeverity = "Warning";
        timeoutSeconds = "600";
        logId = string.Empty;
        profilingOutputPathPrefix = string.Empty;
        enableMemoryPattern = true;
        enableCpuMemoryArena = true;
        enableProfiling = false;
        usingRecommendedParameters = false;
    }

    private void ApplyModelDefaults()
    {
        ApplyCommonDefaults();
        VisualReleaseModel? model = selectedReleaseModel;
        if (model is null)
        {
            modelPath = string.Equals(selectedModelId, "local/onnx", StringComparison.OrdinalIgnoreCase) ? uploadedModelPath ?? string.Empty : string.Empty;
            return;
        }

        ApplyOutputContract(model);

        VisualModelInput? image = model.Inputs.FirstOrDefault(IsImageInput);
        if (image is not null)
        {
            tensorName = image.Name;
            tensorShape = string.Join(',', ResolveShape(image.Shape, model.Task));
        }

        string preprocessing = model.Preprocessing.ToLowerInvariant();
        resizeMode = preprocessing.Contains("letterbox", StringComparison.Ordinal) || preprocessing.Contains("longest-side", StringComparison.Ordinal) ? "pad" : preprocessing.Contains("crop", StringComparison.Ordinal) || preprocessing.Contains("shortest-edge", StringComparison.Ordinal) ? "crop" : "stretch";
        colorOrder = preprocessing.Contains("bgr", StringComparison.Ordinal) ? "bgr" : "rgb";
        if (preprocessing.Contains("half-range", StringComparison.Ordinal))
        {
            imageScale = "0.0078431373";
            meanR = meanG = meanB = "1";
        }
        else if (preprocessing.Contains("mean05", StringComparison.Ordinal))
        {
            imageScale = "0.0039215686";
            meanR = meanG = meanB = "0.5";
        }
        else if (preprocessing.Contains("sam-v1", StringComparison.Ordinal) && preprocessing.Contains("mean-std", StringComparison.Ordinal))
        {
            imageScale = "1";
            meanR = "123.675"; meanG = "116.28"; meanB = "103.53";
            stdR = "58.395"; stdG = "57.12"; stdB = "57.375";
        }
        else if (preprocessing.Contains("imagenet", StringComparison.Ordinal))
        {
            imageScale = "0.0039215686";
            meanR = "0.485"; meanG = "0.456"; meanB = "0.406";
            stdR = "0.229"; stdG = "0.224"; stdB = "0.225";
        }

        string cachedPath = ReleaseCatalog.GetCachedPrimaryPath(model);
        modelPath = model.Cached && File.Exists(cachedPath) ? cachedPath : string.Empty;
        usingRecommendedParameters = true;
    }

    private IReadOnlyList<ReadinessCheck> BuildReadinessChecks()
    {
        VisualReleaseModel? model = selectedReleaseModel;
        bool isDemo = string.Equals(selectedModelId, "demo/yolo-v8-n", StringComparison.OrdinalIgnoreCase);
        bool isOnnxRuntime = IsBackend("onnxruntime");
        bool isTensorRt = IsBackend("tensorrt");
        bool tensorRtArtifact = string.Equals(model?.Format, "onnx", StringComparison.OrdinalIgnoreCase)
            || string.Equals(model?.Format, "tensorrt-engine", StringComparison.OrdinalIgnoreCase)
            || (model is null && IsLocalModelFormatCompatible(InferModelFormat(modelPath), false, tensorRt: true));
        bool supportedVisionBackend = isOnnxRuntime || IsBackend("opencv") || IsBackend("openvino") || isTensorRt && tensorRtArtifact;
        var checks = new List<ReadinessCheck>();

        if (modelUploading)
            checks.Add(new ReadinessCheck(false, "模型", "本地模型仍在上传和校验，请等待完成。"));
        else if (isDemo)
            checks.Add(new ReadinessCheck(true, "模型", "Demo 使用 FakeModelRunner；成功结果不代表真实 ONNX 推理。", true));
        else if (IsActiveModelBundle() && !HasDedicatedModelAdapter(model) && !HasExplicitGenericInput())
            checks.Add(new ReadinessCheck(false, "模型", "当前 ModelPack 是多文件 bundle（" + ActiveModelAssetCount() + " 个已校验文件）。没有专用算法适配器时，请提供真实图像或命名 Tensor JSON；辅助文件会在 Worker 中完整校验。"));
        else if (IsActiveModelBundle() && !HasDedicatedModelAdapter(model))
            checks.Add(new ReadinessCheck(true, "模型", "未发现专用算法适配器，将在 Worker 中执行 manifest 主入口 Tensor；已校验的辅助文件不会被丢弃，输出保持原始 Tensor。", true));
        else if (model is not null && model.Files.Count(file => string.Equals(file.Role, "model", StringComparison.OrdinalIgnoreCase)) > 1 && !HasDedicatedReleaseAdapter(model))
        {
            int modelFileCount = model.Files.Count(file => string.Equals(file.Role, "model", StringComparison.OrdinalIgnoreCase));
            checks.Add(new ReadinessCheck(false, "模型", "当前 release artifact 是多文件模型 bundle（" + modelFileCount + " 个模型文件），Web 单文件入口不会丢弃辅助模型；请使用对应 Worker/ModelPack 链路。"));
        }
        else if (model is not null && !IsReleaseModelFormatCompatible(model.Format, isOnnxRuntime, IsBackend("openvino"), isTensorRt))
            checks.Add(new ReadinessCheck(false, "模型", "当前 Release artifact 格式与所选后端不兼容；OpenVINO IR 只在 OpenVINO Worker 执行。"));
        else if (model is null && !string.IsNullOrWhiteSpace(modelPath) && !IsLocalModelFormatCompatible(InferModelFormat(modelPath), IsBackend("openvino"), isTensorRt))
            checks.Add(new ReadinessCheck(false, "模型", isTensorRt ? "TensorRT 接受 .onnx 并在 Worker 构建 engine，也接受已有 .engine/.plan。" : IsBackend("openvino") ? "OpenVINO 接受 .onnx，或含相邻 .bin 的 .xml IR。" : "当前后端只接受 .onnx；TensorRT .engine/.plan 必须选择 TensorRT。"));
        else if (model is null && IsBackend("openvino") && string.Equals(InferModelFormat(modelPath), "openvino-ir", StringComparison.OrdinalIgnoreCase) && !File.Exists(Path.ChangeExtension(modelPath, ".bin")))
            checks.Add(new ReadinessCheck(false, "模型", "OpenVINO IR 缺少与 .xml 同名且同目录的 .bin 权重文件。"));
        else if (!string.IsNullOrWhiteSpace(modelPath) && File.Exists(modelPath))
            checks.Add(new ReadinessCheck(true, "模型", "模型文件已定位：" + modelPath));
        else if (model is not null)
            checks.Add(new ReadinessCheck(true, "模型", "首次运行会下载并校验 release 模型。", true));
        else if (string.IsNullOrWhiteSpace(modelPath))
            checks.Add(new ReadinessCheck(false, "模型", "请填写存在的本地 .onnx 路径。"));
        else
            checks.Add(new ReadinessCheck(false, "模型", "找不到指定模型文件：" + modelPath));

        if (imagePath is not null && File.Exists(imagePath))
            checks.Add(new ReadinessCheck(true, "输入", "真实图像已准备：" + imageFileName));
        else if (!string.IsNullOrWhiteSpace(tensorJson) && !string.IsNullOrWhiteSpace(modelPath))
            checks.Add(new ReadinessCheck(true, "输入", "将使用命名 Tensor JSON；形状和数值在运行时校验。"));
        else if (model is not null && effectiveTestImage is not null)
            checks.Add(new ReadinessCheck(true, "输入", "未上传图片，运行前会下载并校验默认测试图像 " + effectiveTestImage.FileName + "。", true));
        else if (isDemo)
            checks.Add(new ReadinessCheck(true, "输入", "Demo 不要求真实图像输入。", true));
        else
            checks.Add(new ReadinessCheck(false, "输入", "请上传图像，或同时提供模型路径和 Tensor JSON。"));

        if (model is not null && !HasDedicatedReleaseAdapter(model))
        {
            VisualModelInput? imageInput = model.Inputs.FirstOrDefault(IsImageInput);
            VisualModelInput[] unsupportedInputs = model.Inputs.Where(item => !IsImageInput(item) && !IsSupportedDerivedInput(item)).ToArray();
            if (imageInput is null)
                checks.Add(new ReadinessCheck(false, "输入契约", "该模型没有可由上传图像直接生成的 float 图像 Tensor；需要先完成模型专用前处理链路。"));
            else if (unsupportedInputs.Length > 0)
                checks.Add(new ReadinessCheck(false, "输入契约", "该模型还声明了 " + unsupportedInputs.Length + " 个未知辅助输入（" + string.Join(", ", unsupportedInputs.Select(item => item.Name)) + "），Web 页面不会用零值冒充真实前处理。"));
        }

        if (isDemo && !isOnnxRuntime)
            checks.Add(new ReadinessCheck(false, "后端", "Demo/Fake operation 只用于 ONNX Runtime 入口；请选择真实模型后再使用 Worker 后端。"));
        else if (!supportedVisionBackend)
            checks.Add(new ReadinessCheck(false, "后端", isTensorRt ? "TensorRT 只接受 ONNX 构建源或设备绑定的 .engine/.plan 制品。" : "该后端不能直接运行当前模型格式；请选择兼容后端。"));
        else if (model is not null && !model.RecommendedBackends.Contains(selectedBackend, StringComparer.OrdinalIgnoreCase) && !(isTensorRt && string.Equals(model.Format, "onnx", StringComparison.OrdinalIgnoreCase)))
            checks.Add(new ReadinessCheck(false, "后端", "modelpack 未声明与 " + selectedBackend + " 兼容，不会强行执行。"));
        else if (IsBackend("opencv") && (string.IsNullOrWhiteSpace(outputTensorNames) || string.IsNullOrWhiteSpace(outputTensorShapesJson) || string.IsNullOrWhiteSpace(outputTensorElementTypesJson)))
            checks.Add(new ReadinessCheck(false, "输出合同", "OpenCV DNN 需要精确输出名称、形状和元素类型；Release 模型会自动填充，本地模型需手动填写。"));
        else if (isTensorRt && !string.Equals(device, "cuda", StringComparison.OrdinalIgnoreCase))
            checks.Add(new ReadinessCheck(false, "设备", "TensorRT engine 必须使用 CUDA；CPU 不会加载设备绑定制品。"));
        else if (isTensorRt && !TensorRtConfigurationReady(out string tensorRtDetail))
            checks.Add(new ReadinessCheck(false, "设备身份", tensorRtDetail));
        else if (isTensorRt)
            checks.Add(new ReadinessCheck(true, "设备身份", tensorRtArtifact && string.Equals(model?.Format ?? InferModelFormat(modelPath), "onnx", StringComparison.OrdinalIgnoreCase)
                ? "CUDA、cuDNN、TensorRT 根目录已配置；Worker 将按模型、构建参数、native runtime、驱动和 GPU 身份构建或复用 engine。"
                : "CUDA、cuDNN、TensorRT 根目录和 engine identity 已配置；Worker 将验证版本、GPU、驱动、bridge SHA256 和 engine 来源。", true));
        else if (string.Equals(device, "cuda", StringComparison.OrdinalIgnoreCase))
            checks.Add(new ReadinessCheck(false, "设备", "当前选择不具备已验证的 CUDA provider；不会回退到 CPU。"));
        else if (UsesWorkerForCurrentVision)
            checks.Add(new ReadinessCheck(true, "设备", "将在 net10 Worker 中执行，native runtime 会先探测再加载。"));
        else
            checks.Add(new ReadinessCheck(true, "设备", "ONNX Runtime CPU 进程内执行，运行时仍会进行 native preflight。"));

        checks.Add(new ReadinessCheck(IsShapeValid(), "张量形状", IsShapeValid() ? "当前为 " + tensorShape + "。" : "形状必须是逗号分隔的正整数，例如 1,3,640,640。"));
        checks.Add(new ReadinessCheck(IsTimeoutValid(), "超时", IsTimeoutValid() ? "超时范围为 1 到 3600 秒。" : "超时必须是 1 到 3600 秒之间的整数。"));
        return checks;
    }

    private bool IsShapeValid()
    {
        try { return ParseShape().Length > 0 && ParseShape().All(value => value > 0); }
        catch (FormatException) { return false; }
        catch (OverflowException) { return false; }
    }

    private bool IsTimeoutValid() => int.TryParse(timeoutSeconds, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out int seconds) && seconds is >= 1 and <= 3600;

