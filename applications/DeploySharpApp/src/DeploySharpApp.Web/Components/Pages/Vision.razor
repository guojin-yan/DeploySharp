    private bool TensorRtConfigurationReady(out string detail)
    {
        bool onnxSource = string.Equals(selectedReleaseModel?.Format ?? InferModelFormat(modelPath), "onnx", StringComparison.OrdinalIgnoreCase);
        if (!onnxSource && (string.IsNullOrWhiteSpace(engineIdentityPath) || !File.Exists(engineIdentityPath))) { detail = "已有 engine 必须选择存在的 identity sidecar；没有身份文件时拒绝加载。"; return false; }
        if (!Directory.Exists(cudaRoot)) { detail = "CUDA 根目录不存在。"; return false; }
        if (!Directory.Exists(cudnnRoot)) { detail = "cuDNN 根目录不存在。"; return false; }
        if (!Directory.Exists(tensorRtRoot)) { detail = "TensorRT 根目录不存在。"; return false; }
        if (!string.IsNullOrWhiteSpace(bridgePath) && !File.Exists(bridgePath)) { detail = "指定的 bridge DLL 不存在。"; return false; }
        if (!string.IsNullOrWhiteSpace(sourceOnnxPath) && !File.Exists(sourceOnnxPath)) { detail = "指定的来源 ONNX 不存在。"; return false; }
        if (onnxSource && (!long.TryParse(tensorRtWorkspaceMiB, out long workspaceMiB) || workspaceMiB is < 1 or > 1048576)) { detail = "TensorRT Workspace 必须是 1 到 1048576 MiB 的整数。"; return false; }
        if (onnxSource && tensorRtApiVersion == "11" && tensorRtPrecision is "fp16" or "fp32") { detail = "TensorRT 11 strongly typed network 的精度必须由 ONNX 图决定，请选择 Runtime default 或显式 Q/DQ INT8。"; return false; }
        if (onnxSource && !string.IsNullOrWhiteSpace(tensorRtEngineOutputPath) && Path.GetExtension(tensorRtEngineOutputPath) is string extension && !extension.Equals(".engine", StringComparison.OrdinalIgnoreCase) && !extension.Equals(".plan", StringComparison.OrdinalIgnoreCase)) { detail = "TensorRT engine 输出路径必须以 .engine 或 .plan 结尾。"; return false; }
        if (onnxSource && !TensorRtInputProfilesValid(out detail)) return false;
        detail = string.Empty;
        return true;
    }

    private bool TensorRtInputProfilesValid(out string detail)
    {
        if (string.IsNullOrWhiteSpace(tensorRtInputProfilesJson)) { detail = string.Empty; return true; }
        try
        {
            using System.Text.Json.JsonDocument document = System.Text.Json.JsonDocument.Parse(tensorRtInputProfilesJson);
            if (document.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array) { detail = "动态输入 Profile 必须是 JSON 数组。"; return false; }
            foreach (System.Text.Json.JsonElement profile in document.RootElement.EnumerateArray())
            {
                if (!profile.TryGetProperty("inputName", out System.Text.Json.JsonElement name) || string.IsNullOrWhiteSpace(name.GetString())) { detail = "每个动态输入 Profile 都必须包含 inputName。"; return false; }
                foreach (string key in new[] { "minimum", "optimum", "maximum" })
                    if (!profile.TryGetProperty(key, out System.Text.Json.JsonElement shape) || shape.ValueKind != System.Text.Json.JsonValueKind.Array || shape.GetArrayLength() == 0 || shape.EnumerateArray().Any(value => !value.TryGetInt64(out long dimension) || dimension <= 0)) { detail = "每个动态输入 Profile 都必须包含正整数的 minimum/optimum/maximum 形状。"; return false; }
            }
            detail = string.Empty;
            return true;
        }
        catch (System.Text.Json.JsonException exception) { detail = "动态输入 Profile JSON 无效：" + exception.Message; return false; }
    }

