    private bool IsTensorRtOnnxSource()
        => string.Equals(selectedReleaseModel?.Format ?? InferModelFormat(modelPath), "onnx", StringComparison.OrdinalIgnoreCase);

    private bool TensorRtBuildInputReady()
    {
        if (!IsTensorRtOnnxSource() || modelUploading || modelPackValidating || factoryMaterializing) return false;
        // A Release model may be uncached; the build action will download and
        // verify it before handing the ONNX path to the isolated Worker.
        if (selectedReleaseModel is not null && modelPackMaterialization is null && factoryMaterialization is null) return true;
        return !string.IsNullOrWhiteSpace(modelPath) && File.Exists(modelPath);
    }

    private async Task BuildTensorRtEngineAsync()
    {
        if (tensorRtBuilding || !IsBackend("tensorrt")) return;
        tensorRtBuilding = true;
        tensorRtBuildProgress = 0;
        tensorRtBuildReport = null;
        tensorRtBuildCts = new CancellationTokenSource(TimeSpan.FromMinutes(30));
        Activity.Add("tensorrt-build", "TensorRT ONNX-to-engine preparation started.", "DSAPP-TENSORRT-BUILD-STARTED");
        try
        {
            VisualReleaseModel? selected = selectedReleaseModel;
            bool localMaterialized = modelPackMaterialization is not null || factoryMaterialization is not null;
            if (selected is not null && !localMaterialized)
            {
                await DownloadSelectedAsync(tensorRtBuildCts.Token);
                selected = selectedReleaseModel;
            }
            if (!IsTensorRtOnnxSource() || string.IsNullOrWhiteSpace(modelPath) || !File.Exists(modelPath))
            {
                tensorRtBuildReport = new TensorRtEngineBuildReport(false, AppErrorCode.ModelUnavailable, "请先准备存在的 ONNX 模型文件。", diagnostics: new[] { new RuntimeDiagnostic("DSAPP-TENSORRT-ONNX-NOT-FOUND", DiagnosticSeverity.Warning, "The ONNX source file is missing.", selectedBackend, selected?.LogicalModelId ?? selectedModelId) });
                runtimeState = "ModelUnavailable";
                errorCode = AppErrorCode.ModelUnavailable.ToString();
                runtimeMessage = tensorRtBuildReport.Message;
                return;
            }

            string runtimeModelId = selected?.LogicalModelId ?? (string.IsNullOrWhiteSpace(selectedModelId) ? "local/onnx" : selectedModelId);
            string? resolvedSha256 = localMaterialized ? ActiveModelPackSha256 : selected?.PrimaryFile.Sha256 ?? (string.IsNullOrWhiteSpace(uploadedModelSha256) ? null : uploadedModelSha256);
            var buildRequest = new TensorRtEngineBuildRequest(runtimeModelId, selectedBackend, modelPath, device: "cuda", modelSha256: resolvedSha256, options: BuildTensorRtOptions(selected), timeout: ParseTimeout(), modelAssets: BuildModelAssetReferences());
            tensorRtBuildReport = await Worker.BuildTensorRtEngineAsync(buildRequest, new Progress<double>(value => { tensorRtBuildProgress = value; InvokeAsync(StateHasChanged); }), tensorRtBuildCts.Token);
            runMode = "TensorRT Engine 准备";
            runtimeState = tensorRtBuildReport.RuntimeStatus?.State.ToString() ?? (tensorRtBuildReport.Succeeded ? AppRuntimeState.Available.ToString() : tensorRtBuildReport.ErrorCode.ToString());
            errorCode = tensorRtBuildReport.ErrorCode.ToString();
            runtimeMessage = tensorRtBuildReport.Message;
            diagnostics = tensorRtBuildReport.Diagnostics;
            result = tensorRtBuildReport.Message;
            if (tensorRtBuildReport.Succeeded)
            {
                if (!string.IsNullOrWhiteSpace(tensorRtBuildReport.EnginePath)) tensorRtEngineOutputPath = tensorRtBuildReport.EnginePath!;
                if (!string.IsNullOrWhiteSpace(tensorRtBuildReport.IdentityPath)) engineIdentityPath = tensorRtBuildReport.IdentityPath!;
                tensorRtForceRebuild = false;
                Activity.Add("tensorrt-build", tensorRtBuildReport.Message, tensorRtBuildReport.CacheHit ? "DSAPP-TENSORRT-ENGINE-CACHE-HIT" : "DSAPP-TENSORRT-ENGINE-BUILT");
            }
            else Activity.Add("tensorrt-build", tensorRtBuildReport.Message, tensorRtBuildReport.Diagnostics.FirstOrDefault()?.Code ?? "DSAPP-TENSORRT-BUILD-FAILED");
        }
        catch (OperationCanceledException)
        {
            runtimeState = AppRuntimeState.Unavailable.ToString();
            errorCode = AppErrorCode.Cancelled.ToString();
            runtimeMessage = "TensorRT engine 准备已取消。";
            result = runtimeMessage;
            Activity.Add("tensorrt-build", runtimeMessage, "DSAPP-WEB-CANCELLED");
        }
        catch (Exception exception)
        {
            runtimeState = AppRuntimeState.Unavailable.ToString();
            errorCode = AppErrorCode.WorkerFailed.ToString();
            runtimeMessage = "TensorRT engine 准备失败：" + exception.Message;
            result = runtimeMessage;
            Activity.Add("tensorrt-build", runtimeMessage, "DSAPP-TENSORRT-BUILD-FAILED");
        }
        finally
        {
            tensorRtBuilding = false;
            tensorRtBuildCts?.Dispose();
            tensorRtBuildCts = null;
        }
    }

    private Dictionary<string, string> BuildTensorRtOptions(VisualReleaseModel? selected)
    {
        var options = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["cudaRoot"] = cudaRoot,
            ["cudnnRoot"] = cudnnRoot,
            ["tensorRtRoot"] = tensorRtRoot,
            ["tensorRtApiVersion"] = tensorRtApiVersion,
            ["apiVersion"] = tensorRtApiVersion,
            ["tensorRtPrecision"] = tensorRtPrecision,
            ["tensorRtWorkspaceMiB"] = tensorRtWorkspaceMiB,
            ["tensorRtBuilderOptimizationLevel"] = tensorRtBuilderOptimizationLevel,
            ["tensorRtStronglyTypedNetwork"] = tensorRtStronglyTypedNetwork.ToString(),
            ["tensorRtForceRebuild"] = tensorRtForceRebuild.ToString()
        };
        if (!string.IsNullOrWhiteSpace(bridgePath)) options["bridgePath"] = bridgePath;
        if (!string.IsNullOrWhiteSpace(sourceOnnxPath)) options["sourceOnnxPath"] = sourceOnnxPath;
        if (!string.IsNullOrWhiteSpace(tensorRtEngineOutputPath)) options["tensorRtEngineOutputPath"] = tensorRtEngineOutputPath;
        if (!string.IsNullOrWhiteSpace(engineIdentityPath)) options["engineIdentityPath"] = engineIdentityPath;
        string profilesJson = ResolveTensorRtInputProfiles(selected);
        if (!string.IsNullOrWhiteSpace(profilesJson)) options["tensorRtInputProfilesJson"] = profilesJson;
        return options;
    }

    private async Task RunAsync()
    {
        if (busy) return;
        if (!readinessChecks.All(check => check.Ready))
        {
            runtimeState = "InvalidRequest"; errorCode = "InvalidRequest"; runtimeMessage = "请先处理运行前检查中的阻断项。"; result = runtimeMessage; return;
        }
        busy = true; progress = 0; runSucceeded = false; diagnostics = Array.Empty<RuntimeDiagnostic>();
        cts = new CancellationTokenSource(TimeSpan.FromMinutes(10));
        Activity.Add("run", "Operation started: vision.detect");
        try
        {
            VisualReleaseModel? catalogModel = selectedReleaseModel;
            bool localMaterialized = modelPackMaterialization is not null || factoryMaterialization is not null;
            // A local ModelPack/ModelFactory materialization owns its verified assets. It must not trigger
            // the Release model downloader merely because the catalog contains the same logical model id.
            VisualReleaseModel? selected = catalogModel;
            if (selected is not null && !localMaterialized)
            {
                // DownloadAsync verifies every cached asset before deciding whether a network transfer is needed.
                await DownloadSelectedAsync(cts.Token);
                selected = selectedReleaseModel;
                if (selected is not null && (string.IsNullOrWhiteSpace(modelPath) || !File.Exists(modelPath)))
                {
                    runtimeState = "ModelUnavailable"; runtimeMessage = "请先完成 release 模型下载。"; result = runtimeMessage; return;
                }
            }
            if (imagePath is null && string.IsNullOrWhiteSpace(tensorJson) && catalogModel is not null)
            {
                await DownloadTestImageAsync(effectiveTestImage, cts.Token);
                if (imagePath is null)
                {
                    runtimeState = "ModelUnavailable"; runtimeMessage = "当前模型没有可用的默认测试图像，请上传图片后运行。"; result = runtimeMessage; Activity.Add("run", runtimeMessage, "DSAPP-DEFAULT-IMAGE-UNAVAILABLE"); return;
                }
            }
            ModelTensorInput[]? tensors = BuildTensorInputs(selected);
            var options = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["executionProvider"] = "cpu",
                ["maxConcurrency"] = maxConcurrency,
                ["intraOpThreads"] = intraOpThreads,
                ["interOpThreads"] = interOpThreads,
                ["graphOptimization"] = graphOptimization,
                ["executionMode"] = executionMode,
                ["enableMemoryPattern"] = enableMemoryPattern.ToString(),
                ["enableCpuMemoryArena"] = enableCpuMemoryArena.ToString(),
                ["logSeverity"] = logSeverity,
                ["logId"] = logId,
                ["profilingOutputPathPrefix"] = profilingOutputPathPrefix,
                ["enableProfiling"] = enableProfiling.ToString(),
                ["imageResizeMode"] = resizeMode,
                ["imageColorOrder"] = colorOrder,
                ["imageScale"] = imageScale,
                ["imageMeanR"] = meanR,
                ["imageMeanG"] = meanG,
                ["imageMeanB"] = meanB,
                ["imageStdR"] = stdR,
                ["imageStdG"] = stdG,
                ["imageStdB"] = stdB,
                ["imagePadValue"] = padValue
            };
            ApplyModelPackOptions(options);
            if (BuildModelAssetReferences().Count > 0 && !HasDedicatedModelAdapter(selected))
                options["executionMode"] = "worker";
            if (IsBackend("opencv"))
            {
                if (!string.IsNullOrWhiteSpace(outputTensorNames)) options["outputTensorNames"] = outputTensorNames;
                if (!string.IsNullOrWhiteSpace(outputTensorShapesJson)) options["outputTensorShapesJson"] = outputTensorShapesJson;
                if (!string.IsNullOrWhiteSpace(outputTensorElementTypesJson)) options["outputTensorElementTypesJson"] = outputTensorElementTypesJson;
            }
            if (IsBackend("tensorrt"))
            {
                foreach (KeyValuePair<string, string> option in BuildTensorRtOptions(selected)) options[option.Key] = option.Value;
            }
            if (selected is not null)
            {
                if (!localMaterialized)
                {
                    var assetPaths = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                foreach (VisualReleaseFile file in selected.Files)
                {
                        string path = ReleaseCatalog.GetCachedFilePath(selected, file);
                        // Bundle assets may share a role (SAM has two model files); retain both the role and stable filename keys.
                        if (!assetPaths.ContainsKey(file.Role)) assetPaths[file.Role] = path;
                        assetPaths[file.AssetName] = path;
                        assetPaths[file.RelativePath] = path;
                        if (file.Role.Contains("vocab", StringComparison.OrdinalIgnoreCase) || file.Role.Contains("label", StringComparison.OrdinalIgnoreCase))
                        {
                            assetPaths["labels"] = path;
                            assetPaths["vocabulary"] = path;
                        }
                    }
                    options["visualAssetPathsJson"] = System.Text.Json.JsonSerializer.Serialize(assetPaths);
                }
                options["visualPostprocessingKind"] = selected.PostprocessingProfile.Kind.ToString();
                options["visualUpstreamRepository"] = selected.UpstreamRepository;
                options["visualUpstreamRevision"] = selected.UpstreamRevision;
                options["visualExporter"] = selected.Exporter;
                options["visualExporterVersion"] = selected.ExporterVersion;
                options["visualLicense"] = selected.License;
                if (selected.Opset.HasValue) options["visualOpset"] = selected.Opset.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
            }
            if (selected?.LogicalModelId.Equals("segmentation/sam-v1-vit-b", StringComparison.OrdinalIgnoreCase) == true)
            {
                (string left, string top) = ParseNormalizedPair(samBoxLeftTop, "SAM 框左/上");
                (string right, string bottom) = ParseNormalizedPair(samBoxRightBottom, "SAM 框右/下");
                options["samPointX"] = ParseNormalized(samPointX, "SAM 前景点 X");
                options["samPointY"] = ParseNormalized(samPointY, "SAM 前景点 Y");
                options["samBoxLeft"] = left;
                options["samBoxTop"] = top;
                options["samBoxRight"] = right;
                options["samBoxBottom"] = bottom;
                options["samReturnMultipleMasks"] = samReturnMultipleMasks.ToString();
            }
            string runtimeModelId = selected?.LogicalModelId ?? (string.IsNullOrWhiteSpace(selectedModelId) ? "local/model" : selectedModelId);
            string? resolvedSha256 = localMaterialized ? ActiveModelPackSha256 : selected?.PrimaryFile.Sha256 ?? (string.IsNullOrWhiteSpace(uploadedModelSha256) ? ActiveModelPackSha256 : uploadedModelSha256);
            var request = new ModelRunRequest(AppOperationKind.Vision, runtimeModelId, selectedBackend, device, inputPath: imagePath, modelPath: string.IsNullOrWhiteSpace(modelPath) ? null : modelPath, modelFormat: string.IsNullOrWhiteSpace(modelPath) ? null : (selected?.Format ?? InferModelFormat(modelPath)), modelSha256: resolvedSha256, tensorInputs: tensors, options: options, timeout: ParseTimeout(), modelAssets: BuildModelAssetReferences());
            var output = await Service.RunAsync(request, new Progress<double>(value => { progress = value; InvokeAsync(StateHasChanged); }), cts.Token);
            runSucceeded = output.Succeeded; runMode = output.RunMode.ToString(); runtimeState = output.RuntimeStatus?.State.ToString() ?? (output.Succeeded ? "Available" : output.ErrorCode.ToString()); errorCode = output.ErrorCode.ToString(); runtimeMessage = output.RuntimeStatus?.Message ?? output.Message; diagnostics = output.Diagnostics; result = output.Message + (string.IsNullOrWhiteSpace(output.Output) ? string.Empty : "\n" + VisionResultRenderer.FormatForDisplay(output.Output)); preprocessMs = output.PreprocessMs; inferenceMs = output.InferenceMs; postprocessMs = output.PostprocessMs; totalMs = output.TotalMs;
            if (output.Succeeded && originalImageUrl is not null) { resultImageUrl = BuildResultImage(output, originalImageUrl, selectedReleaseModel?.Task, selectedReleaseModel?.PostprocessingProfile); resultImageCaption = "原图坐标叠加任务级后处理；下方摘要不输出 mask 数值"; }
            Activity.Add("run", output.Message, output.Diagnostics.FirstOrDefault()?.Code);
        }
        catch (OperationCanceledException) { runMode = "Cancelled"; runtimeState = "Unavailable"; errorCode = "Cancelled"; runtimeMessage = "操作已取消。"; result = runtimeMessage; Activity.Add("run", runtimeMessage, "DSAPP-WEB-CANCELLED"); }
        catch (Exception exception) { runMode = "InvalidRequest"; runtimeState = "Unavailable"; errorCode = "InvalidRequest"; runtimeMessage = exception.Message; result = "操作失败：" + exception.Message; Activity.Add("run", runtimeMessage, "DSAPP-WEB-UNEXPECTED"); }
        finally { busy = false; cts?.Dispose(); cts = null; }
    }

    private ModelTensorInput[]? BuildTensorInputs(VisualReleaseModel? selected)
    {
        // Dedicated visual Worker adapters own image preprocessing and auxiliary tensors (SAM prompts,
        // detector scale factors, OCR contracts, and so on). Supplying synthetic values here would make
        // a valid release bundle fail before the adapter is reached.
        if (selected is not null && HasDedicatedReleaseAdapter(selected)) return null;
        if (imagePath is null)
        {
            return string.IsNullOrWhiteSpace(tensorJson) || string.IsNullOrWhiteSpace(modelPath) ? null : new[] { new ModelTensorInput(tensorName, "float32", ParseShape(), valuesJson: tensorJson) };
        }
        VisualModelInput? image = selected?.Inputs.FirstOrDefault(IsImageInput);
        string name = image?.Name ?? tensorName;
        long[] shape = ResolveShape(image?.Shape ?? ParseShape(), selected?.Task);
        var inputs = new List<ModelTensorInput> { new ModelTensorInput(name, "float32", shape, imageInput: true) };
        if (selected is not null)
        {
            foreach (VisualModelInput auxiliary in selected.Inputs.Where(item => !string.Equals(item.Name, name, StringComparison.Ordinal)))
            {
                long[] auxiliaryShape = ResolveShape(auxiliary.Shape, selected.Task);
                long count = auxiliaryShape.Aggregate(1L, (total, dimension) => checked(total * dimension));
                if (count > 4096) continue;
                string values = BuildAuxiliaryValues(auxiliary, auxiliaryShape, selected);
                inputs.Add(new ModelTensorInput(auxiliary.Name, auxiliary.ElementType, auxiliaryShape, valuesJson: values));
            }
        }
        return inputs.ToArray();
    }

    private string ResolveTensorRtInputProfiles(VisualReleaseModel? selected)
    {
        if (!string.IsNullOrWhiteSpace(tensorRtInputProfilesJson)) return tensorRtInputProfilesJson;
        if (selected is null) return string.Empty;
        object[] profiles = selected.Inputs.Where(input => input.Shape.Any(dimension => dimension <= 0)).Select(input =>
        {
            long[] shape = ResolveShape(input.Shape, selected.Task);
            return (object)new { inputName = input.Name, minimum = shape, optimum = shape, maximum = shape };
        }).ToArray();
        return profiles.Length == 0 ? string.Empty : System.Text.Json.JsonSerializer.Serialize(profiles);
    }

    private string? ActiveModelPackSha256 => modelPackMaterialization?.Assets.FirstOrDefault(asset => asset.Role == JYPPX.DeploySharp.ModelPack.Json.ModelFileRole.Model)?.Sha256
        ?? factoryMaterialization?.Assets.FirstOrDefault(asset => asset.Role == JYPPX.DeploySharp.ModelPack.Json.ModelFileRole.Model)?.Sha256;

    private IReadOnlyList<ModelAssetReference> BuildModelAssetReferences()
    {
        IReadOnlyList<ModelPackAsset> assets = modelPackMaterialization?.Assets ?? factoryMaterialization?.Assets ?? Array.Empty<ModelPackAsset>();
        return assets.Select(asset => new ModelAssetReference(asset.RelativePath, asset.FullPath, asset.Role.ToString(), asset.Sha256, asset.Size)).ToArray();
    }

    private void ApplyModelPackOptions(IDictionary<string, string> options)
    {
        IReadOnlyList<ModelPackAsset> assets = modelPackMaterialization?.Assets ?? factoryMaterialization?.Assets ?? Array.Empty<ModelPackAsset>();
        if (assets.Count > 0)
        {
            var paths = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (ModelPackAsset asset in assets)
            {
                paths.TryAdd(asset.Role.ToString(), asset.FullPath);
                paths[asset.RelativePath] = asset.FullPath;
                paths[Path.GetFileName(asset.FullPath)] = asset.FullPath;
                string role = asset.Role.ToString();
                if (role.Contains("vocab", StringComparison.OrdinalIgnoreCase) || role.Contains("label", StringComparison.OrdinalIgnoreCase))
                {
                    paths["labels"] = asset.FullPath;
                    paths["vocabulary"] = asset.FullPath;
                }
            }
            options["visualAssetPathsJson"] = System.Text.Json.JsonSerializer.Serialize(paths);
        }
        int? opset = modelPackMaterialization?.Opset ?? factoryMaterialization?.Opset;
        if (opset.HasValue) options["visualOpset"] = opset.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        string? bundleRole = modelPackMaterialization?.BundleRole ?? factoryMaterialization?.BundleRole;
        if (!string.IsNullOrWhiteSpace(bundleRole)) options["visualBundleRole"] = bundleRole!;
        string? bundleRoot = modelPackMaterialization?.PackageRoot ?? factoryMaterialization?.PackageRoot;
        if (!string.IsNullOrWhiteSpace(bundleRoot)) options["modelBundleRoot"] = bundleRoot!;
    }

    private static bool IsImageInput(VisualModelInput input) => input.Shape.Count == 4 && (input.Shape[1] is 1 or 3 or 4) && (input.ElementType.Equals("float32", StringComparison.OrdinalIgnoreCase) || input.ElementType.Equals("float", StringComparison.OrdinalIgnoreCase));
    private static bool IsSupportedDerivedInput(VisualModelInput input) => input.Name.Equals("orig_target_sizes", StringComparison.OrdinalIgnoreCase) || input.Name.Equals("im_shape", StringComparison.OrdinalIgnoreCase) || input.Name.Equals("scale_factor", StringComparison.OrdinalIgnoreCase);
    private string BuildAuxiliaryValues(VisualModelInput input, IReadOnlyList<long> shape, VisualReleaseModel model)
    {
        long count = shape.Aggregate(1L, (total, dimension) => checked(total * dimension));
        if (!IsSupportedDerivedInput(input) || shape.Count != 2 || shape[1] != 2 || imagePath is null)
            throw new InvalidOperationException("The release model declares an unsupported derived input: " + input.Name);
        try
        {
            ImageInfo? info = Image.Identify(imagePath);
            if (info is null) return "[1,1]";
            long targetHeight = ResolveShape(model.Inputs.First(item => IsImageInput(item)).Shape, model.Task)[2];
            long targetWidth = ResolveShape(model.Inputs.First(item => IsImageInput(item)).Shape, model.Task)[3];
            if (input.Name.Equals("scale_factor", StringComparison.OrdinalIgnoreCase))
            {
                double scaleY = targetHeight / (double)Math.Max(1, info.Height);
                double scaleX = targetWidth / (double)Math.Max(1, info.Width);
                return "[" + scaleY.ToString("R", System.Globalization.CultureInfo.InvariantCulture) + "," + scaleX.ToString("R", System.Globalization.CultureInfo.InvariantCulture) + "]";
            }
            bool heightFirst = input.Name.Equals("im_shape", StringComparison.OrdinalIgnoreCase) || model.LogicalModelId.Contains("deim", StringComparison.OrdinalIgnoreCase) || model.DisplayName.Contains("DEIM", StringComparison.OrdinalIgnoreCase);
            long first = heightFirst ? info.Height : info.Width;
            long second = heightFirst ? info.Width : info.Height;
            return "[" + first.ToString(System.Globalization.CultureInfo.InvariantCulture) + "," + second.ToString(System.Globalization.CultureInfo.InvariantCulture) + "]";
        }
        catch (InvalidOperationException) { throw; }
        catch (Exception exception) { throw new InvalidOperationException("Unable to derive the release image auxiliary input " + input.Name + ".", exception); }
    }
    private static long[] ResolveShape(IReadOnlyList<long> shape, string? task) { long fallback = task?.Contains("matting", StringComparison.OrdinalIgnoreCase) == true ? 1024 : 640; return shape.Select((value, index) => value > 0 ? value : index == 0 ? 1 : index == 1 ? 3 : fallback).ToArray(); }
    private long[] ParseShape() => tensorShape.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(item => long.Parse(item.Trim(), System.Globalization.CultureInfo.InvariantCulture)).ToArray();
    private static (string First, string Second) ParseNormalizedPair(string value, string label)
    {
        string[] parts = value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length != 2) throw new FormatException(label + " 必须包含两个逗号分隔的 0 到 1 数值。");
        return (ParseNormalized(parts[0], label), ParseNormalized(parts[1], label));
    }
    private static string ParseNormalized(string value, string label)
    {
        if (!double.TryParse(value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out double parsed) || !double.IsFinite(parsed) || parsed < 0 || parsed > 1)
            throw new FormatException(label + " 必须是 0 到 1 的有限数值。");
        return parsed.ToString("R", System.Globalization.CultureInfo.InvariantCulture);
    }
    private TimeSpan ParseTimeout()
    {
        if (!int.TryParse(timeoutSeconds, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out int seconds) || seconds is < 1 or > 3600)
            throw new FormatException("超时必须是 1 到 3600 秒之间的整数。");
        return TimeSpan.FromSeconds(seconds);
    }
    private void MarkCustomParameters()
    {
        usingRecommendedParameters = false;
        tensorRtBuildReport = null;
    }
    private void HandleBackendChanged()
    {
        usingRecommendedParameters = false;
        if (selectedReleaseModel is VisualReleaseModel model) ApplyOutputContract(model);
    }
    private void ApplyOutputContract(VisualReleaseModel model)
    {
        outputTensorNames = string.Join(',', model.Outputs.Select(output => output.Name));
        outputTensorShapesJson = System.Text.Json.JsonSerializer.Serialize(model.Outputs.ToDictionary(output => output.Name, output => output.Shape));
        outputTensorElementTypesJson = System.Text.Json.JsonSerializer.Serialize(model.Outputs.ToDictionary(output => output.Name, output => output.ElementType));
    }
    private void ReplaceModel(VisualReleaseModel model) { int index = releaseModels.FindIndex(item => string.Equals(item.Id, model.Id, StringComparison.OrdinalIgnoreCase)); if (index >= 0) releaseModels[index] = model; }
    private void Cancel()
    {
        cts?.Cancel();
        tensorRtBuildCts?.Cancel();
        Activity.Add("run", tensorRtBuilding ? "TensorRT engine preparation cancellation requested" : "Cancellation requested", "DSAPP-WEB-CANCEL-REQUESTED");
    }
    private static long[] ParseShape(string value) => value.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(item => long.Parse(item.Trim(), System.Globalization.CultureInfo.InvariantCulture)).ToArray();
    private bool IsBackend(string token) => selectedBackend.Contains(token, StringComparison.OrdinalIgnoreCase);
    private static string InferModelFormat(string path)
    {
        string extension = Path.GetExtension(path).ToLowerInvariant();
        return extension is ".engine" or ".plan" ? "tensorrt-engine" : extension == ".xml" ? "openvino-ir" : extension.TrimStart('.');
    }
    private static bool IsReleaseModelFormatCompatible(string format, bool onnxRuntime, bool openVino, bool tensorRt)
        => string.Equals(format, "onnx", StringComparison.OrdinalIgnoreCase) && (onnxRuntime || openVino || tensorRt)
            || string.Equals(format, "openvino-ir", StringComparison.OrdinalIgnoreCase) && openVino
            || string.Equals(format, "tensorrt-engine", StringComparison.OrdinalIgnoreCase) && tensorRt;
    private static bool IsLocalModelFormatCompatible(string format, bool openVino, bool tensorRt)
        => tensorRt ? string.Equals(format, "onnx", StringComparison.OrdinalIgnoreCase) || string.Equals(format, "tensorrt-engine", StringComparison.OrdinalIgnoreCase)
            : string.Equals(format, "onnx", StringComparison.OrdinalIgnoreCase) || openVino && string.Equals(format, "openvino-ir", StringComparison.OrdinalIgnoreCase);
    private static string TensorContract(IReadOnlyList<VisualModelInput> tensors) => tensors.Count == 0 ? "未声明" : string.Join("; ", tensors.Select(tensor => tensor.Name + " " + tensor.ElementType + " " + string.Join("×", tensor.Shape)));
    private static string Metric(double value) => value <= 0 ? "—" : value.ToString("F2") + " ms";
    private static string BuildResultImage(ModelRunResult output, string originalImage, string? task, VisualPostprocessingProfile? profile) => VisionResultRenderer.Render(originalImage, output.Output, task, profile);

    public void Dispose()
    {
        cts?.Cancel();
        tensorRtBuildCts?.Cancel();
        DeleteOwnedImage();
        if (!string.IsNullOrWhiteSpace(uploadedModelPath) && File.Exists(uploadedModelPath))
        {
            try { File.Delete(uploadedModelPath); } catch (IOException) { }
            catch (UnauthorizedAccessException) { }
        }
    }
