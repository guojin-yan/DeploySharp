@page "/vision"
@implements IDisposable
@using DeploySharpApp.Contracts
@using DeploySharpApp.Application
@using DeploySharpApp.Infrastructure
@using System.Security.Cryptography
@using SixLabors.ImageSharp
@inject DeploySharpAppService Service
@inject VisualReleaseCatalogService ReleaseCatalog
@inject VisualTestImageCatalogService TestImageCatalog
@inject ModelFactoryCatalogService FactoryCatalog
@inject ModelFactoryRuntimeService FactoryRuntime
@inject ModelPackRuntimeService ModelPackRuntime
@inject WebActivityStore Activity
@inject IBackendHostWorkerClient Worker
<PageTitle>视觉推理 · DeploySharpApp</PageTitle>
<style>
    .workbench { align-items: start; grid-template-columns: minmax(360px, 420px) minmax(0, 1fr); }
    .config, .canvas-panel { min-width: 0; }
    .two-col { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .two-col > label { min-width: 0; overflow: hidden; }
    .config input:not([type="file"]) { width: 100%; min-width: 0; border: 1px solid var(--line); border-radius: 8px; padding: 10px; background: #fafbfe; color: var(--ink); font: inherit; font-size: 11px; margin-top: 7px; outline: none; }
    .canvas-panel { overflow: hidden; }
    .result-box { height: 190px; min-height: 190px; overflow: hidden; }
    .result-box pre { width: 100%; height: 100%; min-height: 0; max-height: 100%; overflow: auto; padding: 14px; white-space: pre-wrap; overflow-wrap: anywhere; }
    .image-results { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-top: 12px; }
    .image-results figure { min-width: 0; margin: 0; overflow: hidden; border-radius: 10px; background: #f3f6fb; }
    .image-results img { display: block; width: 100%; height: clamp(360px, 58vh, 760px); object-fit: contain; background: #eef1f7; }
    .image-results figcaption { padding: 8px 10px; color: #778198; font-size: 10px; }
    .download-row { display: flex; gap: 8px; align-items: center; margin-top: 12px; }
    .download-row progress { flex: 1; min-width: 0; }
    .download-row .muted { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .build-report { margin-top: 10px; border: 1px solid #e5eaf6; border-radius: 10px; padding: 10px; background: #fbfcff; }
    .build-report code { display: block; margin-top: 4px; overflow-wrap: anywhere; color: #3c4c6b; font-size: 10px; }
    .file-name { display: block; margin-top: 6px; color: #778198; font-size: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .catalog-loading { margin: 12px 0; color: #778198; font-size: 10px; }
    .settings-group { border-top: 1px solid var(--line); margin-top: 18px; padding-top: 3px; }
    .settings-group summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 10px; color: var(--ink); font-size: 12px; font-weight: 800; padding: 10px 0 2px; }
    .settings-group summary::-webkit-details-marker { display: none; }
    .settings-group summary::after { content: '+'; color: #9aa5bb; font-size: 16px; font-weight: 400; }
    .settings-group[open] summary::after { content: '−'; }
    .settings-group summary span { color: #7e8ba5; font-size: 10px; font-weight: 500; margin-left: auto; text-align: right; }
    .settings-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 10px; }
    .three-col { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 8px; }
    .check-label { display: flex !important; align-items: center; gap: 7px; color: #748098; font-size: 11px; font-weight: 700; }
    .config input[type="checkbox"] { width: 15px; height: 15px; margin: 7px 0 0; accent-color: var(--blue); }
    .config .check-label input[type="checkbox"] { margin-top: 7px; }
    .model-evidence { margin-top: 12px; border: 1px solid #e5eaf6; border-radius: 10px; padding: 11px; background: #fbfcff; }
    .model-evidence-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 9px; }
    .model-evidence-grid div { min-width: 0; }
    .model-evidence-grid small { display: block; color: #9aa5bb; font-size: 9px; text-transform: uppercase; letter-spacing: .4px; }
    .model-evidence-grid b, .model-evidence-grid span { display: block; color: #44516f; font-size: 10px; line-height: 1.45; margin-top: 3px; overflow-wrap: anywhere; }
    .source-badge { display: inline-flex; align-items: center; gap: 5px; margin-top: 12px; padding: 5px 8px; border-radius: 7px; background: #f0f3fb; color: #5b6b8e; font-size: 10px; font-weight: 700; }
    .source-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #8290ad; }
    .source-badge.real::before { background: #23a477; }
    .reset-row { display: flex; gap: 8px; align-items: center; margin-top: 13px; }
    .reset-row .hint { margin: 0; }
    .evidence-head { margin-top: 19px; }
    .readiness-panel { margin: 18px 0 12px; padding: 11px; border: 1px solid #e5eaf6; border-radius: 9px; background: #fbfcff; }
    .readiness-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; color: var(--ink); font-size: 11px; }
    .readiness-head .status-tag { flex: 0 0 auto; }
    .readiness-list { display: grid; gap: 7px; margin-top: 10px; }
    .readiness-item { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 7px; align-items: start; color: #65728b; font-size: 10px; line-height: 1.45; }
    .readiness-item::before { content: '✓'; display: grid; place-items: center; width: 16px; height: 16px; border-radius: 50%; background: #e6f7ef; color: #198a63; font-size: 10px; font-weight: 800; }
    .readiness-item.attention::before { content: '!'; background: #fff3dc; color: #bd7414; }
    .readiness-item.blocked::before { content: '!'; background: #fde9e8; color: #c34b4b; }
    .readiness-item b { color: #44516f; margin-right: 5px; }
    @@media(max-width:1180px) { .workbench { grid-template-columns: 1fr; } }
    @@media(max-width:760px) { .image-results img { height: clamp(300px, 52vh, 560px); } .model-evidence-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .settings-group summary { align-items: flex-start; flex-wrap: wrap; } .settings-group summary span { width: 100%; margin-left: 0; text-align: left; overflow-wrap: anywhere; } .settings-group summary::after { position: absolute; right: 0; } .settings-group summary { position: relative; padding-right: 20px; } .download-row { align-items: flex-start; flex-wrap: wrap; } .download-row .muted { width: 100%; white-space: normal; overflow-wrap: anywhere; } }
    @@media(max-width:430px) { .two-col, .settings-grid, .three-col, .model-evidence-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
<div class="section-head"><div><span class="eyebrow">VISION WORKBENCH</span><h3>视觉推理</h3></div><span class="status-tag">@backendExecutionLabel</span></div>
<div class="workbench">
    <section class="panel config">
        <div class="panel-head"><div><span class="eyebrow">01 · CONFIGURE</span><h3>配置一次运行</h3></div></div>
        <span class="source-badge @(selectedReleaseModel is null ? "" : "real")">@parameterModeLabel</span>
        <label>模型 Artifact
            <select value="@selectedModelId" @onchange="HandleModelChanged">
                <option value="demo/yolo-v8-n">Demo · YOLOv8 Nano</option>
                <option value="local/onnx">本地 ONNX · 自定义模型</option>
                @if (releaseModels.Count > 0)
                {
                    <optgroup label="DeploySharp Visual Models · @VisualReleaseCatalogService.ReleaseTag">
                        @foreach (VisualReleaseModel model in releaseModels) { <option value="@model.Id">@model.DisplayName · @model.Format · @model.Size</option> }
                    </optgroup>
                }
            </select>
        </label>
        @if (FactoryCatalog.Items.Count > 0)
        {
            <label>ModelFactory 已校验目录
                <select value="@selectedFactoryModelId" @onchange="HandleFactoryModelChanged"><option value="">选择目录模型并物化到服务器</option>@foreach (var item in FactoryCatalog.Items) { <option value="@item.Id">@item.Name · @item.Task</option> }</select>
            </label>
            @if (!string.IsNullOrWhiteSpace(selectedFactoryModelId)) { <div class="download-row"><span class="muted">ModelPack 会先校验 manifest、SHA256 和缓存</span><button class="ghost small" @onclick="MaterializeFactoryModelAsync" disabled="@(factoryMaterializing || busy)">@(factoryMaterializing ? "物化中…" : "物化并用于运行")</button></div> }
            @if (factoryMaterializing) { <progress value="@factoryProgress" max="1"></progress> }
            @if (factoryMaterialization is not null) { <p class="hint">已接入 ModelPack：@factoryMaterialization.Format · @factoryMaterialization.ModelPath</p> }
            @if (!string.IsNullOrWhiteSpace(factoryError)) { <p class="hint">ModelFactory：@factoryError</p> }
        }
        @if (catalogLoading) { <p class="catalog-loading">正在读取 GitHub release 模型清单… @catalogProgress.ToString("P0")</p> }
        @if (!string.IsNullOrWhiteSpace(catalogError)) { <p class="hint">release 清单暂时不可用：@catalogError 仍可使用本地模型。</p> }
        @if (testImageLoading) { <p class="catalog-loading">正在读取 test-assets.1 测试图像清单…</p> }
        @if (!string.IsNullOrWhiteSpace(testImageError)) { <p class="hint">测试图像清单暂时不可用：@testImageError 仍可上传自己的图片。</p> }
        @if (selectedReleaseModel is not null)
        {
            <div class="download-row"><span class="muted">@(selectedReleaseModel.Cached ? "已缓存" : "首次运行需下载")</span><button class="ghost small" @onclick="() => DownloadSelectedAsync()" disabled="@downloading">@(downloading ? "下载中…" : "下载模型")</button></div>
            @if (downloading) { <progress value="@downloadProgress" max="1"></progress> }
            <p class="hint">@selectedReleaseModel.Task · @selectedReleaseModel.Version · SHA256 @selectedReleaseModel.PrimaryFile.Sha256[..Math.Min(12, selectedReleaseModel.PrimaryFile.Sha256.Length)]…</p>
            <div class="model-evidence"><div class="model-evidence-grid"><div><small>任务</small><b>@selectedReleaseModel.Task</b></div><div><small>精度 / 量化</small><b>@selectedReleaseModel.Precision · @selectedReleaseModel.Quantization</b></div><div><small>ONNX opset</small><b>@(selectedReleaseModel.Opset?.ToString() ?? "未声明")</b></div><div><small>输入契约</small><b>@TensorContract(selectedReleaseModel.Inputs)</b></div><div><small>输出契约</small><b>@TensorContract(selectedReleaseModel.Outputs)</b></div><div><small>后处理类型</small><b>@selectedReleaseModel.PostprocessingProfile.Kind</b></div><div><small>预处理</small><span>@selectedReleaseModel.Preprocessing</span></div><div><small>验证状态</small><span>@selectedReleaseModel.ValidationStatus</span></div></div><p class="hint">后处理契约：@selectedReleaseModel.Postprocessing。@selectedReleaseModel.PostprocessingProfile.Description 类别名或文本只在模型合同提供时显示，不会猜测。</p></div>
        }
        <label>本地模型文件
            <InputFile OnChange="HandleModelSelected" accept=".onnx,.engine,.plan" disabled="@modelUploading" />
            <span class="file-name">@(string.IsNullOrWhiteSpace(modelFileName) ? "可上传 .onnx/.engine/.plan；OpenVINO IR 请填写含相邻 .bin 的服务器 .xml 路径" : modelFileName)</span>
        </label>
        @if (modelUploading)
        {
            <div class="download-row"><span class="muted">正在上传并计算 SHA256…</span><progress value="@modelUploadProgress" max="1"></progress></div>
        }
        @if (!string.IsNullOrWhiteSpace(uploadedModelSha256)) { <p class="hint">本地模型 SHA256：@uploadedModelSha256</p> }
        <label>本地模型路径<input @bind="modelPath" @bind:after="MarkCustomParameters" placeholder="Web 服务可访问的 .onnx/.xml/.engine 路径" /></label>
        <details class="settings-group"><summary>本地 ModelPack <span>严格校验 manifest、大小、SHA256 与路径边界</span></summary>
            <label>Manifest 路径<input @bind="modelPackManifestPath" placeholder="Web 服务器可访问的 modelpack.json 路径" /></label>
            <div class="download-row"><button class="ghost small" @onclick="ValidateModelPackAsync" disabled="@(modelPackValidating || busy || string.IsNullOrWhiteSpace(modelPackManifestPath))">@(modelPackValidating ? "校验中…" : "校验并用于运行")</button><span class="muted">校验失败不会替换当前模型</span></div>
            @if (modelPackMaterialization is not null) { <p class="hint">已验证 @modelPackMaterialization.ModelId · @modelPackMaterialization.Format · @modelPackMaterialization.ModelPath · @(modelPackMaterialization.IsBundle ? "多文件 bundle" : "单文件入口") · @modelPackMaterialization.VerifiedFiles.Count 个文件</p> }
            @if (!string.IsNullOrWhiteSpace(modelPackError)) { <p class="hint">ModelPack：@modelPackError</p> }
        </details>
        <label>输入图像 <InputFile OnChange="HandleImageSelected" accept="image/png,image/jpeg,image/webp" /><span class="file-name">@(string.IsNullOrWhiteSpace(imageFileName) ? "未选择图片，运行将自动匹配 release 测试图像" : imageFileName)</span></label>
        @if (testImages.Count > 0)
        {
            <label>Release 测试图像
                <select value="@selectedTestImageId" @onchange="HandleTestImageChanged">
                    <option value="">@(selectedReleaseModel is null ? "仅使用本地上传图像" : "按模型任务自动匹配")</option>
                    @foreach (VisualTestImage image in testImages) { <option value="@image.Id">@image.FileName · @string.Join(", ", image.Tasks)</option> }
                </select>
            </label>
        }
        @if (effectiveTestImage is not null && imagePath is null)
        {
            <div class="download-row"><span class="muted">默认图像：@effectiveTestImage.FileName · @(effectiveTestImage.Cached ? "本地缓存，运行前仍会校验" : "首次运行需下载")</span><button class="ghost small" @onclick="() => DownloadTestImageAsync()" disabled="@(downloadingImage || busy)">@(downloadingImage ? "下载中…" : "使用测试图像")</button></div>
            @if (downloadingImage) { <progress value="@imageDownloadProgress" max="1"></progress> }
        }
        <details class="settings-group" open><summary>输入与预处理 <span>真实影响图像张量</span></summary>
            <label>命名 Tensor JSON<textarea @bind="tensorJson" @bind:after="MarkCustomParameters" placeholder="无图像时例如 [1,2,3]；上传图片后自动生成图像张量"></textarea></label>
            <div class="two-col"><label>Tensor 名称<input @bind="tensorName" @bind:after="MarkCustomParameters" /></label><label>Tensor 形状<input @bind="tensorShape" @bind:after="MarkCustomParameters" /></label></div>
            <div class="settings-grid"><label>缩放模式<select @bind="resizeMode" @bind:after="MarkCustomParameters"><option value="stretch">Stretch · 拉伸</option><option value="pad">Pad · 等比填充</option><option value="crop">Crop · 居中裁剪</option></select></label><label>颜色顺序<select @bind="colorOrder" @bind:after="MarkCustomParameters"><option value="rgb">RGB</option><option value="bgr">BGR</option></select></label></div>
            <div class="settings-grid"><label>像素缩放<input type="number" step="any" @bind="imageScale" @bind:after="MarkCustomParameters" /></label><label>填充像素<input type="number" min="0" max="255" step="1" @bind="padValue" @bind:after="MarkCustomParameters" /></label></div>
            <span class="muted">通道均值</span><div class="three-col"><label>R<input type="number" step="any" @bind="meanR" @bind:after="MarkCustomParameters" /></label><label>G<input type="number" step="any" @bind="meanG" @bind:after="MarkCustomParameters" /></label><label>B<input type="number" step="any" @bind="meanB" @bind:after="MarkCustomParameters" /></label></div>
            <span class="muted">通道标准差（必须大于 0）</span><div class="three-col"><label>R<input type="number" step="any" min="0.000001" @bind="stdR" @bind:after="MarkCustomParameters" /></label><label>G<input type="number" step="any" min="0.000001" @bind="stdG" @bind:after="MarkCustomParameters" /></label><label>B<input type="number" step="any" min="0.000001" @bind="stdB" @bind:after="MarkCustomParameters" /></label></div>
            <div class="reset-row"><button class="ghost small" @onclick="ApplyCommonDefaults">恢复通用默认</button><button class="ghost small" @onclick="ApplyModelDefaults" disabled="@(selectedReleaseModel is null)">使用模型推荐值</button></div>
        </details>
        @if (selectedReleaseModel?.LogicalModelId.Equals("segmentation/sam-v1-vit-b", StringComparison.OrdinalIgnoreCase) == true)
        {
            <details class="settings-group" open><summary>SAM 提示 <span>归一化到原图坐标</span></summary>
                <div class="two-col"><label>前景点 X<input type="number" min="0" max="1" step="0.01" @bind="samPointX" @bind:after="MarkCustomParameters" /></label><label>前景点 Y<input type="number" min="0" max="1" step="0.01" @bind="samPointY" @bind:after="MarkCustomParameters" /></label></div>
                <div class="two-col"><label>框左 / 上<input @bind="samBoxLeftTop" @bind:after="MarkCustomParameters" placeholder="0.1,0.1" /></label><label>框右 / 下<input @bind="samBoxRightBottom" @bind:after="MarkCustomParameters" placeholder="0.9,0.9" /></label></div>
                <label class="check-label"><input type="checkbox" @bind="samReturnMultipleMasks" @bind:after="MarkCustomParameters" />返回候选 mask</label>
            </details>
        }
        @if (IsBackend("opencv"))
        {
            <details class="settings-group" open><summary>OpenCV 输出合同 <span>本地模型必须填写</span></summary>
                <label>输出 Tensor 名称<input @bind="outputTensorNames" @bind:after="MarkCustomParameters" placeholder="例如 scores,boxes" /></label>
                <label>输出形状 JSON<textarea @bind="outputTensorShapesJson" @bind:after="MarkCustomParameters" placeholder='例如 {"scores":[1,1000]}'></textarea></label>
                <label>输出类型 JSON<textarea @bind="outputTensorElementTypesJson" @bind:after="MarkCustomParameters" placeholder='例如 {"scores":"float32"}'></textarea></label>
            </details>
        }
        @if (IsBackend("tensorrt"))
        {
            <details class="settings-group" open><summary>TensorRT 构建与设备身份 <span>ONNX 在 Worker 转 engine；外部 engine 严格校验</span></summary>
                <label>Engine 输出路径（ONNX 可选）<input @bind="tensorRtEngineOutputPath" @bind:after="MarkCustomParameters" placeholder="留空写入设备身份绑定的本地缓存" /></label>
                <label>Engine identity sidecar<input @bind="engineIdentityPath" @bind:after="MarkCustomParameters" placeholder="ONNX 自动生成；外部 .engine/.plan 必填" /></label>
                <label>来源 ONNX（外部 engine 可选）<input @bind="sourceOnnxPath" @bind:after="MarkCustomParameters" placeholder="填写后校验来源模型 SHA256" /></label>
                <label>CUDA 根目录<input @bind="cudaRoot" @bind:after="MarkCustomParameters" placeholder="例如 C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.9" /></label>
                <label>cuDNN 根目录<input @bind="cudnnRoot" @bind:after="MarkCustomParameters" placeholder="包含 bin/include/lib" /></label>
                <label>TensorRT 根目录<input @bind="tensorRtRoot" @bind:after="MarkCustomParameters" placeholder="包含 bin/include/lib" /></label>
                <div class="two-col"><label>Bridge DLL（可选）<input @bind="bridgePath" @bind:after="MarkCustomParameters" placeholder="留空使用 Worker 随附 bridge" /></label><label>TensorRT API line<select @bind="tensorRtApiVersion" @bind:after="MarkCustomParameters"><option value="8">8</option><option value="10">10</option><option value="11">11</option></select></label></div>
                <div class="two-col"><label>构建精度<select @bind="tensorRtPrecision" @bind:after="MarkCustomParameters"><option value="runtime-default">Runtime default</option><option value="fp32">FP32</option><option value="fp16">FP16</option><option value="int8-explicit">INT8（显式 Q/DQ）</option></select></label><label>Workspace（MiB）<input type="number" min="1" max="1048576" step="1" @bind="tensorRtWorkspaceMiB" @bind:after="MarkCustomParameters" /></label></div>
                <div class="two-col"><label>Builder 优化级别<select @bind="tensorRtBuilderOptimizationLevel" @bind:after="MarkCustomParameters"><option value="-1">运行时默认</option><option value="0">0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option></select></label><label class="check-label"><input type="checkbox" @bind="tensorRtStronglyTypedNetwork" @bind:after="MarkCustomParameters" />Strongly typed network</label></div>
                <label>动态输入 Profile JSON<textarea @bind="tensorRtInputProfilesJson" @bind:after="MarkCustomParameters" placeholder='[{"inputName":"images","minimum":[1,3,320,320],"optimum":[1,3,640,640],"maximum":[1,3,1280,1280]}]'></textarea></label>
                <label class="check-label"><input type="checkbox" @bind="tensorRtForceRebuild" @bind:after="MarkCustomParameters" />忽略兼容缓存并重新构建 engine</label>
            </details>
        }
        <details class="settings-group"><summary>运行与性能 <span>@backendExecutionLabel · 点击展开</span></summary>
            <label>后端<select @bind="selectedBackend" @bind:after="HandleBackendChanged">@foreach (var backend in Service.Backends.Where(item => (item.Capabilities & AppBackendCapability.Vision) != 0)) { <option value="@backend.Id">@backend.DisplayName · @backend.State</option> }</select></label>
            <div class="two-col"><label>设备<select @bind="device" @bind:after="MarkCustomParameters"><option value="cpu">@(UsesWorkerForCurrentVision ? "CPU · Worker" : "CPU · 进程内")</option><option value="cuda">CUDA · 需匹配 Worker</option></select></label><label>最大并发<input type="number" min="1" max="64" step="1" @bind="maxConcurrency" @bind:after="MarkCustomParameters" /></label></div>
            <div class="two-col"><label>算子内线程<input type="number" min="0" max="256" step="1" @bind="intraOpThreads" @bind:after="MarkCustomParameters" /></label><label>算子间线程<input type="number" min="0" max="256" step="1" @bind="interOpThreads" @bind:after="MarkCustomParameters" /></label></div>
            <div class="settings-grid"><label>图优化<select @bind="graphOptimization" @bind:after="MarkCustomParameters"><option>Disabled</option><option>Basic</option><option>Extended</option><option>All</option></select></label><label>执行模式<select @bind="executionMode" @bind:after="MarkCustomParameters"><option>Sequential</option><option>Parallel</option></select></label></div>
            <div class="settings-grid"><label>原生日志<select @bind="logSeverity" @bind:after="MarkCustomParameters"><option>Verbose</option><option>Information</option><option>Warning</option><option>Error</option><option>Fatal</option></select></label><label>超时（秒）<input type="number" min="1" max="3600" step="1" @bind="timeoutSeconds" @bind:after="MarkCustomParameters" /></label></div>
            <div class="settings-grid"><label>原生日志 ID<input @bind="logId" @bind:after="MarkCustomParameters" placeholder="可选，便于筛选日志" /></label><label>Profiling 输出前缀<input @bind="profilingOutputPathPrefix" @bind:after="MarkCustomParameters" placeholder="启用 profiling 时可选" /></label></div>
            <div class="settings-grid"><label class="check-label"><input type="checkbox" @bind="enableMemoryPattern" @bind:after="MarkCustomParameters" />启用 Memory Pattern</label><label class="check-label"><input type="checkbox" @bind="enableCpuMemoryArena" @bind:after="MarkCustomParameters" />启用 CPU Memory Arena</label><label class="check-label"><input type="checkbox" @bind="enableProfiling" @bind:after="MarkCustomParameters" />启用 Core Profiling</label></div>
        </details>
        <div class="readiness-panel">
            <div class="readiness-head"><b>运行前检查</b><span class="status-tag @(readinessChecks.All(check => check.Ready) ? "" : "orange-tag")">@readinessHeadline</span></div>
            <div class="readiness-list">@foreach (ReadinessCheck check in readinessChecks) { <div class="readiness-item @(check.Ready ? check.Attention ? "attention" : "" : "blocked")"><span><b>@check.Label</b>@check.Detail</span></div> }</div>
        </div>
        <button class="primary wide" disabled="@(busy || !readinessChecks.All(check => check.Ready))" @onclick="RunAsync">@(busy ? "运行中…" : "运行推理 →")</button>
        @if (IsBackend("tensorrt") && IsTensorRtOnnxSource())
        {
            <button class="ghost wide" disabled="@(busy || tensorRtBuilding || downloading || !TensorRtBuildInputReady())" @onclick="BuildTensorRtEngineAsync">@(tensorRtBuilding ? "转换 Engine 中…" : "先转换 / 准备 TensorRT Engine")</button>
            @if (tensorRtBuilding) { <progress value="@tensorRtBuildProgress" max="1"></progress> }
            @if (tensorRtBuildReport is not null)
            {
                <div class="build-report">
                    <b>@(tensorRtBuildReport.Succeeded ? (tensorRtBuildReport.CacheHit ? "已复用兼容 Engine" : "Engine 转换完成") : "Engine 转换未完成")</b>
                    <span class="muted"> · @tensorRtBuildReport.Message</span>
                    @if (!string.IsNullOrWhiteSpace(tensorRtBuildReport.EnginePath)) { <code>Engine: @tensorRtBuildReport.EnginePath</code> }
                    @if (!string.IsNullOrWhiteSpace(tensorRtBuildReport.IdentityPath)) { <code>Identity: @tensorRtBuildReport.IdentityPath</code> }
                    @if (!string.IsNullOrWhiteSpace(tensorRtBuildReport.EngineSha256)) { <code>SHA256: @tensorRtBuildReport.EngineSha256</code> }
                </div>
            }
        }
        <button class="ghost wide" disabled="@(!busy)" @onclick="Cancel">取消当前运行</button>
        <div class="hint">真实推理会校验模型路径、图片尺寸、命名输入、native runtime 和 ABI；没有图片且未提供 tensor 时不会伪造测试输入。CUDA 请求会明确返回不可用，不会回退到 CPU。</div>
        <progress value="@progress" max="1"></progress>
    </section>
    <section class="panel canvas-panel">
        <div class="panel-head"><div><span class="eyebrow">02 · INPUT / OUTPUT</span><h3>输入与结果</h3></div><span class="status-tag @(runSucceeded ? "" : "orange-tag")">@runMode</span></div>
        @if (!string.IsNullOrWhiteSpace(originalImageUrl))
        {
            <div class="image-results"><figure><img src="@originalImageUrl" alt="原始输入图像" /><figcaption>原图 · @imageFileName</figcaption></figure>@if (!string.IsNullOrWhiteSpace(resultImageUrl)) { <figure><img src="@resultImageUrl" alt="推理结果图" /><figcaption>推理结果图 · @resultImageCaption</figcaption></figure> }</div>
        }
        else
        {
            <div class="dropzone"><div class="drop-icon">＋</div><strong>上传图片或使用 release 默认测试图</strong><span>图片只上传到当前 Web 服务，不在浏览器加载 native DLL</span></div>
        }
        <div class="result-box @(busy ? "running" : "")"><pre>@result</pre></div>
        <div class="metric-row"><div class="metric"><small>预处理</small><strong>@Metric(preprocessMs)</strong></div><div class="metric"><small>推理</small><strong>@Metric(inferenceMs)</strong></div><div class="metric"><small>后处理</small><strong>@Metric(postprocessMs)</strong></div><div class="metric accent"><small>端到端</small><strong>@Metric(totalMs)</strong></div></div>
        <div class="panel-head evidence-head"><div><span class="eyebrow">RUNTIME EVIDENCE</span><h3>@runtimeState</h3></div><span class="muted">@errorCode</span></div>
        <p class="hint">@runtimeMessage</p>@if (diagnostics.Count > 0) { <div class="diagnostics">@foreach (var diagnostic in diagnostics) { <div><b>@diagnostic.Code</b><span>@diagnostic.Message</span></div> }</div> }
    </section>
</div>
@code {
    private readonly List<VisualReleaseModel> releaseModels = new();
