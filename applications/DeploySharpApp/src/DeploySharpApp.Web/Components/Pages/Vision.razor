    private async Task HandleImageSelected(InputFileChangeEventArgs args)
    {
        IBrowserFile file = args.File;
        if (file.Size > 20 * 1024 * 1024) { runtimeMessage = "图片不能超过 20 MB。"; return; }
        DeleteOwnedImage();
        string directory = Path.Combine(Path.GetTempPath(), "DeploySharpApp", "images");
        Directory.CreateDirectory(directory);
        imagePath = Path.Combine(directory, Guid.NewGuid().ToString("N") + Path.GetExtension(file.Name));
        ownedImagePath = imagePath;
        try
        {
            await using (Stream source = file.OpenReadStream(20 * 1024 * 1024))
            await using (var destination = new FileStream(imagePath, FileMode.Create, FileAccess.Write, FileShare.None, 128 * 1024, useAsync: true))
            { await source.CopyToAsync(destination); }
            selectedTestImageId = string.Empty;
            imageFromRelease = false;
            await SetImagePreviewAsync(imagePath, file.Name, string.IsNullOrWhiteSpace(file.ContentType) ? "image/*" : file.ContentType);
            runtimeMessage = "图片已上传到 Web 服务，运行时将生成真实图像张量。";
        }
        catch (Exception exception)
        {
            DeleteOwnedImage();
            imagePath = null;
            runtimeMessage = "图片上传失败：" + exception.Message;
            Activity.Add("image-upload", runtimeMessage, "DSAPP-IMAGE-UPLOAD-FAILED");
        }
    }

    private async Task HandleModelSelected(InputFileChangeEventArgs args)
    {
        IBrowserFile file = args.File;
        string extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (extension is not ".onnx" and not ".engine" and not ".plan")
        {
            runtimeMessage = "视觉页只接受 .onnx；TensorRT 设备制品使用 .engine 或 .plan。";
            return;
        }
        const long maxModelUploadBytes = 4L * 1024 * 1024 * 1024;
        if (file.Size <= 0 || file.Size > maxModelUploadBytes)
        {
            runtimeMessage = "模型文件必须大于 0 且不超过 4 GB。";
            return;
        }

        modelUploading = true;
        modelUploadProgress = 0;
        string directory = Path.Combine(Path.GetTempPath(), "DeploySharpApp", "models");
        Directory.CreateDirectory(directory);
        string targetPath = Path.Combine(directory, Guid.NewGuid().ToString("N") + extension);
        try
        {
            using IncrementalHash hash = IncrementalHash.CreateHash(HashAlgorithmName.SHA256);
            await using Stream source = file.OpenReadStream(maxModelUploadBytes);
            await using var destination = new FileStream(targetPath, FileMode.CreateNew, FileAccess.Write, FileShare.None, 128 * 1024, useAsync: true);
            byte[] buffer = new byte[128 * 1024];
            long completed = 0;
            int read;
            while ((read = await source.ReadAsync(buffer.AsMemory())) != 0)
            {
                await destination.WriteAsync(buffer.AsMemory(0, read));
                hash.AppendData(buffer, 0, read);
                completed += read;
                modelUploadProgress = Math.Min(1, completed / (double)file.Size);
                await InvokeAsync(StateHasChanged);
            }
            await destination.FlushAsync();
            string previous = uploadedModelPath ?? string.Empty;
            uploadedModelPath = targetPath;
            modelPath = targetPath;
            modelFileName = Path.GetFileName(file.Name);
            uploadedModelSha256 = Convert.ToHexString(hash.GetHashAndReset()).ToLowerInvariant();
            selectedModelId = "local/onnx";
            selectedTestImageId = string.Empty;
            usingRecommendedParameters = false;
            if (!string.IsNullOrWhiteSpace(previous) && !string.Equals(previous, targetPath, StringComparison.OrdinalIgnoreCase) && File.Exists(previous)) File.Delete(previous);
            runtimeMessage = "本地模型已上传并通过 SHA256 计算，可以继续配置后端。";
            Activity.Add("model-upload", "Uploaded local model " + modelFileName, "DSAPP-LOCAL-MODEL-UPLOADED");
        }
        catch (Exception exception)
        {
            if (File.Exists(targetPath)) File.Delete(targetPath);
            runtimeMessage = "本地模型上传失败：" + exception.Message;
            Activity.Add("model-upload", runtimeMessage, "DSAPP-LOCAL-MODEL-UPLOAD-FAILED");
        }
        finally
        {
            modelUploading = false;
        }
    }

