@page "/vision"
@using DeploySharpApp.Contracts
@using DeploySharpApp.Application
@inject DeploySharpAppService Service
<PageTitle>视觉推理 · DeploySharpApp</PageTitle>
<h1>视觉推理</h1>
<div class="workbench"><section class="panel"><h2>配置一次运行</h2><label>模型 Artifact<select @bind="selectedModel"><option value="">请选择</option>@foreach (var model in Service.Models) { <option value="@model.Id">@model.DisplayName · @model.Format</option> }</select></label><label>本地 ONNX 模型路径<input @bind="modelPath" placeholder="留空时 demo/* 使用 Fake 模式" /></label><label>命名 Tensor JSON<input @bind="tensorJson" placeholder="例如 [1,2,3]" /></label><label>Tensor 名称<input @bind="tensorName" /></label><label>Tensor 形状<input @bind="tensorShape" placeholder="例如 1,3" /></label><label>后端<select @bind="selectedBackend">@foreach (var backend in Service.Backends) { <option value="@backend.Id">@backend.DisplayName · @backend.State</option> }</select></label><label>设备<select @bind="device"><option>cpu</option><option>cuda</option></select></label><div><button class="primary" disabled="@busy" @onclick="RunAsync">@(busy ? "运行中…" : "运行推理")</button><button class="ghost" disabled="@(!busy)" @onclick="Cancel">取消</button></div><progress value="@progress" max="1"></progress></section><section class="panel output"><h2>结果与诊断</h2><div class="run-state"><b>@runMode</b><span class="state @runtimeState.ToLowerInvariant()">@runtimeState</span></div><pre>@result</pre><h3>性能</h3><p>推理 @(inferenceMs.ToString("F1")) ms · 端到端 @(totalMs.ToString("F1")) ms</p></section></div>
@code {
    private string selectedBackend = "deploysharp.backend.onnxruntime"; private string selectedModel = "demo/yolo-v8-n"; private string device = "cpu"; private string modelPath = string.Empty; private string tensorJson = string.Empty; private string tensorName = "images"; private string tensorShape = "1,3,2,2"; private string result = "运行后将在此显示结果。"; private string runMode = "尚未运行"; private string runtimeState = "Unavailable"; private bool busy; private double progress; private double inferenceMs; private double totalMs; private CancellationTokenSource? cts;
    private async Task RunAsync() { if (busy) return; busy = true; progress = 0; cts = new CancellationTokenSource(TimeSpan.FromMinutes(2)); try { var tensors = string.IsNullOrWhiteSpace(modelPath) ? null : new[] { new ModelTensorInput(tensorName, "float32", tensorShape.Split(',').Select(long.Parse), valuesJson: tensorJson) }; var request = new ModelRunRequest(AppOperationKind.Vision, selectedModel, selectedBackend, device, modelPath: string.IsNullOrWhiteSpace(modelPath) ? null : modelPath, modelFormat: string.IsNullOrWhiteSpace(modelPath) ? null : "onnx", tensorInputs: tensors); var p = new Progress<double>(value => { progress = value; InvokeAsync(StateHasChanged); }); var output = await Service.RunAsync(request, p, cts.Token); runMode = output.RunMode.ToString(); runtimeState = output.RuntimeStatus?.State.ToString() ?? (output.Succeeded ? "Available" : output.ErrorCode.ToString()); result = output.Message + (string.IsNullOrWhiteSpace(output.Output) ? string.Empty : "\n" + output.Output) + (output.Diagnostics.Count == 0 ? string.Empty : "\nDiagnostics: " + string.Join(", ", output.Diagnostics.Select(item => item.Code))); inferenceMs = output.InferenceMs; totalMs = output.TotalMs; } catch (OperationCanceledException) { runMode = "Cancelled"; runtimeState = "Unavailable"; result = "操作已取消。"; } catch (Exception ex) { runMode = "InvalidRequest"; runtimeState = "Unavailable"; result = "操作失败：" + ex.Message; } finally { busy = false; cts.Dispose(); cts = null; } }
    private void Cancel() => cts?.Cancel();
}
