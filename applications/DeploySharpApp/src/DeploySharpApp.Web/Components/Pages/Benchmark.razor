@page "/benchmark"
@implements IDisposable
@using DeploySharpApp.Contracts
@inject DeploySharpAppService Service
@inject WebActivityStore Activity
<PageTitle>性能基准 · DeploySharpApp</PageTitle>
<style>
    .bench-config { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 12px; }
    .bench-config label { min-width: 0; color: #748098; font-size: 10px; font-weight: 800; }
    .bench-config input, .bench-config select, .bench-config textarea { display: block; width: 100%; min-width: 0; margin-top: 6px; padding: 9px; border: 1px solid var(--line); border-radius: 7px; background: white; color: var(--ink); font: inherit; font-size: 11px; }
    .bench-config textarea { min-height: 68px; resize: vertical; }
    .bench-wide { grid-column: 1 / -1; }
    .bench-actions { display: flex; gap: 8px; margin-top: 12px; }
    .bench-evidence { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 10px; color: #778198; font-size: 10px; }
    @@media(max-width:700px) { .bench-config { grid-template-columns: 1fr; } .bench-wide { grid-column: auto; } }
</style>
<div class="section-head"><div><span class="eyebrow">PERFORMANCE LAB</span><h3>性能基准</h3></div><span class="status-tag">@reportState</span></div>
<div class="benchmark-hero panel">
    <div>
        <span class="eyebrow">NATIVE BENCHMARK</span><h3>真实适配器基准</h3>
        <p>Worker 仅初始化一次 provider/session；warmup 不入样本，P50/P95 只覆盖真实执行。缺模型、输入或 native runtime 时不生成数字。</p>
        <div class="bench-config">
            <label>后端<select @bind="selectedBackend"><option value="deploysharp.backend.onnxruntime">ONNX Runtime · Worker</option>@foreach (var backend in Service.Backends.Where(item => !item.Id.Contains("onnxruntime", StringComparison.OrdinalIgnoreCase))) { <option value="@backend.Id">@backend.DisplayName · Worker</option> }</select></label>
            <label>设备<select @bind="device"><option value="cpu">CPU</option><option value="auto">Auto</option><option value="cuda">CUDA</option></select></label>
            @if (IsOnnx) { <label class="bench-wide"><input type="checkbox" @bind="useDemoBenchmark" /> 使用明确标记的 Demo 基准（不加载模型）</label> }
            <label>Warmup<input type="number" min="0" max="1000" @bind="warmup" /></label>
            <label>Iterations<input type="number" min="1" max="10000" @bind="iterations" /></label>
            @if (!IsDemoBackend)
            {
                <label class="bench-wide">模型路径<input @bind="modelPath" placeholder="服务器本地 .onnx / .gguf / .engine" /></label>
                @if (IsLlama)
                {
                    <label class="bench-wide">固定 Prompt<textarea @bind="prompt" placeholder="每次迭代使用相同 prompt"></textarea></label>
                    <label>最大生成 Token<input type="number" min="1" max="4096" @bind="maxTokens" /></label>
                }
                else
                {
                    <label class="bench-wide">输入图像路径<input @bind="inputPath" placeholder="使用图像张量时必填；也可在下方提供数值 JSON" /></label>
                    <label>Tensor 名称<input @bind="tensorName" /></label><label>Tensor 形状<input @bind="tensorShape" placeholder="1,3,640,640" /></label>
                    <label class="bench-wide">Tensor 数值 JSON<textarea @bind="tensorValuesJson" placeholder="图像路径为空时必填，例如 [1,2,3,4]"></textarea></label>
                    @if (IsOpenCv)
                    {
                        <label>输出名称<input @bind="outputTensorNames" placeholder="scores,boxes" /></label>
                        <label>输出形状 JSON<input @bind="outputTensorShapesJson" placeholder='{"scores":[1,1000]}' /></label>
                        <label class="bench-wide">输出类型 JSON<input @bind="outputTensorElementTypesJson" placeholder='{"scores":"float32"}' /></label>
                    }
                }
            }
        </div>
        <div class="bench-actions"><button class="primary small" @onclick="RunBenchmarkAsync" disabled="@busy">@(busy ? "测试中…" : "运行基准")</button><button class="ghost small" @onclick="Cancel" disabled="@(!busy)">取消</button></div>
    </div>
    <div class="bench-summary"><div><small>Warmup</small><strong>@warmup</strong></div><div><small>Iterations</small><strong>@iterations</strong></div><div><small>报告</small><strong class="good">@reportState</strong></div></div>
</div>
<div class="panel table-panel">
    <div class="panel-head"><div><span class="eyebrow">LATEST REPORT</span><h3>后端对比</h3></div><span class="muted">@lastRun</span></div>
    <table><thead><tr><th>后端</th><th>状态</th><th>P50 延迟</th><th>P95 延迟</th><th>吞吐</th><th>执行模式</th></tr></thead><tbody>@foreach (var backend in Service.Backends) { var latest = reports.TryGetValue(backend.Id, out var value) ? value : null; <tr><td><b>@backend.DisplayName</b><small>@backend.Version</small></td><td><span class="table-status @(latest?.Available == true ? "ok" : "pending")">@(latest?.Available == true ? "已完成" : latest is null ? backend.State.ToString() : "不可用")</span></td><td>@(latest?.Available == true ? latest.P50Ms.ToString("F2") + " ms" : "—")</td><td>@(latest?.Available == true ? latest.P95Ms.ToString("F2") + " ms" : "—")</td><td>@(latest?.Available == true ? latest.Throughput.ToString("F1") + "/s" : "—")</td><td>@(latest?.ExecutionMode ?? backend.ExecutionMode.ToString())</td></tr> }</tbody></table>
    <progress value="@progress" max="1"></progress><p class="hint">@message</p>
    @if (lastDiagnostics.Count > 0) { <div class="bench-evidence">@foreach (RuntimeDiagnostic diagnostic in lastDiagnostics) { <span>@diagnostic.Code · @diagnostic.Message</span> }</div> }
</div>
@code {
    private readonly Dictionary<string, BenchmarkReport> reports = new(StringComparer.OrdinalIgnoreCase);
    private bool busy;
    private double progress;
    private string reportState = "等待运行";
    private string lastRun = "尚未执行";
    private string message = "所有后端默认通过 Worker 复用一次真实 provider/session；只有显式勾选时才运行 Demo。";
    private string selectedBackend = "deploysharp.backend.onnxruntime";
    private string device = "cpu";
    private string modelPath = string.Empty;
    private string inputPath = string.Empty;
    private string tensorName = "images";
    private string tensorShape = "1,3,640,640";
    private string tensorValuesJson = string.Empty;
    private string prompt = string.Empty;
    private int maxTokens = 32;
    private int warmup = 3;
    private int iterations = 20;
    private string outputTensorNames = string.Empty;
    private string outputTensorShapesJson = string.Empty;
    private string outputTensorElementTypesJson = string.Empty;
    private bool useDemoBenchmark;
    private IReadOnlyList<RuntimeDiagnostic> lastDiagnostics = Array.Empty<RuntimeDiagnostic>();
    private CancellationTokenSource? cancellation;
    private bool IsOnnx => selectedBackend.Contains("onnxruntime", StringComparison.OrdinalIgnoreCase);
    private bool IsDemoBackend => IsOnnx && useDemoBenchmark;
    private bool IsLlama => selectedBackend.Contains("llamasharp", StringComparison.OrdinalIgnoreCase);
    private bool IsOpenCv => selectedBackend.Contains("opencv", StringComparison.OrdinalIgnoreCase);

    private async Task RunBenchmarkAsync()
    {
        if (busy) return;
        busy = true; progress = 0; reportState = "运行中"; message = "正在执行可复核基准…"; lastDiagnostics = Array.Empty<RuntimeDiagnostic>();
        cancellation = new CancellationTokenSource(TimeSpan.FromMinutes(10));
        try
        {
            var options = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            IReadOnlyList<ModelTensorInput>? tensors = null;
            if (!IsDemoBackend)
            {
                if (string.IsNullOrWhiteSpace(modelPath)) throw new InvalidOperationException("native benchmark 必须填写模型路径。");
                if (IsLlama)
                {
                    if (string.IsNullOrWhiteSpace(prompt)) throw new InvalidOperationException("LLamaSharp benchmark 必须填写固定 prompt。");
                    options["prompt"] = prompt; options["maxTokens"] = maxTokens.ToString(System.Globalization.CultureInfo.InvariantCulture);
                }
                else
                {
                    long[] shape = tensorShape.Split(new[] { ',', 'x', '×' }, StringSplitOptions.RemoveEmptyEntries).Select(value => long.Parse(value.Trim(), System.Globalization.CultureInfo.InvariantCulture)).ToArray();
                    bool image = !string.IsNullOrWhiteSpace(inputPath);
                    if (!image && string.IsNullOrWhiteSpace(tensorValuesJson)) throw new InvalidOperationException("请提供输入图像路径或 Tensor 数值 JSON。");
                    tensors = new[] { new ModelTensorInput(tensorName, "float32", shape, image ? null : tensorValuesJson, imageInput: image) };
                    options["imageResizeMode"] = "stretch"; options["imageColorOrder"] = "rgb"; options["imageScale"] = "0.0039215686";
                    if (IsOpenCv) { options["outputTensorNames"] = outputTensorNames; options["outputTensorShapesJson"] = outputTensorShapesJson; options["outputTensorElementTypesJson"] = outputTensorElementTypesJson; }
                }
            }
            var request = new BenchmarkRequest(IsDemoBackend ? "demo/benchmark" : "web/benchmark", selectedBackend, warmup, iterations, device, IsDemoBackend ? null : modelPath, IsDemoBackend ? null : InferFormat(modelPath), inputPath: string.IsNullOrWhiteSpace(inputPath) ? null : inputPath, tensorInputs: tensors, options: options);
            BenchmarkReport report = await Service.BenchmarkAsync(request, new Progress<double>(value => { progress = value; InvokeAsync(StateHasChanged); }), cancellation.Token);
            reports[request.BackendId] = report; reportState = report.Available ? (IsDemoBackend ? "Demo" : "可复核") : "不可用"; message = report.Message; lastDiagnostics = report.Diagnostics; lastRun = DateTimeOffset.Now.ToString("yyyy-MM-dd HH:mm"); Activity.Add("benchmark", report.Message, report.Diagnostics.FirstOrDefault()?.Code);
        }
        catch (OperationCanceledException) { reportState = "已取消"; message = "基准已取消。"; }
        catch (Exception exception) { reportState = "输入无效"; message = exception.Message; }
        finally { busy = false; cancellation?.Dispose(); cancellation = null; }
    }

    private void Cancel() => cancellation?.Cancel();
    private static string InferFormat(string path) => Path.GetExtension(path).Equals(".gguf", StringComparison.OrdinalIgnoreCase) ? "gguf" : Path.GetExtension(path).Equals(".engine", StringComparison.OrdinalIgnoreCase) || Path.GetExtension(path).Equals(".plan", StringComparison.OrdinalIgnoreCase) ? "tensorrt-engine" : Path.GetExtension(path).TrimStart('.');
    public void Dispose() { cancellation?.Cancel(); cancellation?.Dispose(); }
}
