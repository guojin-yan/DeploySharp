@page "/multimodal"
@implements IDisposable
@inject DeploySharpAppService Service
@inject VisualReleaseCatalogService ReleaseCatalog
@inject VisualTestImageCatalogService TestImageCatalog
@inject WebActivityStore Activity
<PageTitle>多模态工作流 · DeploySharpApp</PageTitle>
<style>
    .multimodal-grid { display: grid; grid-template-columns: minmax(350px, 430px) minmax(0, 1fr); gap: 16px; align-items: start; }
    .multi-config, .multi-result { min-width: 0; }
    .multi-config label { display: block; margin-top: 13px; color: #748098; font-size: 10px; font-weight: 800; }
    .multi-config input:not([type="file"]), .multi-config select { width: 100%; min-width: 0; margin-top: 7px; border: 1px solid var(--line); border-radius: 8px; padding: 10px; background: #fafbfe; color: var(--ink); font: inherit; font-size: 11px; }
    .mode-tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px; padding: 4px; border-radius: 8px; background: #eef1f7; margin-top: 13px; }
    .mode-tabs button { min-height: 34px; border: 0; border-radius: 6px; background: transparent; color: #6f7c94; font-size: 11px; font-weight: 800; cursor: pointer; }
    .mode-tabs button.active { background: white; color: var(--ink); box-shadow: 0 1px 4px rgba(38, 48, 76, .1); }
    .file-name { display: block; margin-top: 6px; color: #778198; font-size: 10px; overflow-wrap: anywhere; }
    .progress-row { display: grid; grid-template-columns: minmax(0, 1fr) 54px; gap: 9px; align-items: center; margin-top: 10px; }
    .progress-row progress { width: 100%; }
    .progress-row span { color: #68758e; font-size: 10px; text-align: right; }
    .bundle-list { display: grid; gap: 6px; margin-top: 11px; }
    .bundle-file { display: grid; grid-template-columns: 74px minmax(0, 1fr); gap: 8px; font-size: 10px; }
    .bundle-file b { color: #67748d; }
    .bundle-file span { color: #909aaf; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 16px; }
    .actions .primary, .actions .ghost { min-height: 36px; }
    .run-note { margin: 11px 0 0; color: #778198; font-size: 10px; line-height: 1.55; }
    .image-stage { min-height: 320px; display: grid; place-items: center; overflow: hidden; border-radius: 8px; background: #eef1f6; }
    .image-stage img { display: block; width: 100%; height: 360px; object-fit: contain; }
    .image-empty { color: #9aa5b8; font-size: 11px; }
    .caption-output { min-height: 118px; margin-top: 13px; padding: 15px; border-left: 3px solid #3678d4; background: #f6f8fc; color: #27334b; font-size: 14px; line-height: 1.65; white-space: pre-wrap; overflow-wrap: anywhere; }
    .evidence-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 9px; margin-top: 13px; }
    .evidence-grid div { min-width: 0; padding: 10px; border: 1px solid var(--line); border-radius: 7px; background: #fbfcff; }
    .evidence-grid small { display: block; color: #969fb0; font-size: 9px; text-transform: uppercase; }
    .evidence-grid b { display: block; margin-top: 4px; color: #4e5b74; font-size: 10px; overflow-wrap: anywhere; }
    .diagnostic-box { margin-top: 12px; color: #68758e; font-size: 10px; line-height: 1.55; }
    @@media(max-width:1050px) { .multimodal-grid { grid-template-columns: 1fr; } }
    @@media(max-width:680px) { .evidence-grid { grid-template-columns: 1fr; } .image-stage img { height: 260px; } }
</style>

<div class="section-head">
    <div><span class="eyebrow">VISION + LANGUAGE</span><h3>多模态工作流</h3></div>
    <span class="status-tag @(lastSucceeded ? "green-tag" : busy ? "orange-tag" : null)">@(busy ? "Worker 运行中" : lastSucceeded ? "真实推理完成" : "ONNX Runtime CPU")</span>
</div>

<div class="multimodal-grid">
    <section class="panel multi-config">
        <div class="panel-title"><div><span class="eyebrow">MODEL BUNDLE</span><h4>@(selectedIsClip ? "CLIP 图像 Embedding" : "BLIP 图像描述")</h4></div><span class="status-tag">Worker</span></div>
        <div class="mode-tabs" role="group" aria-label="模型来源">
            <button class="@(useRelease ? "active" : null)" @onclick="UseRelease" disabled="@busy">Release 模型</button>
            <button class="@(!useRelease ? "active" : null)" @onclick="UseLocal" disabled="@busy">本地 bundle</button>
        </div>

        @if (useRelease)
        {
            <label>发布模型
                <select value="@selectedModelId" @onchange="HandleModelChanged" disabled="@(busy || loadingCatalog)">
                    @if (loadingCatalog) { <option value="">正在读取 Release…</option> }
                    @foreach (VisualReleaseModel model in releaseModels) { <option value="@model.Id">@model.DisplayName · @model.Size</option> }
                </select>
            </label>
            @if (selectedModel is VisualReleaseModel releaseModel)
            {
                <div class="bundle-list">
                    <div class="bundle-file"><b>模型格式</b><span>@releaseModel.Format · @releaseModel.Precision · opset @(releaseModel.Opset?.ToString() ?? "未声明")</span></div>
                    <div class="bundle-file"><b>文件数量</b><span>@releaseModel.Files.Count 个校验资产 · @releaseModel.License</span></div>
                    <div class="bundle-file"><b>缓存状态</b><span>@(releaseModel.Cached ? "已缓存；运行时仍会复验 SHA256" : "首次运行将下载约 " + releaseModel.Size)</span></div>
                </div>
                @if (!releaseModel.Cached)
                {
                    <div class="actions"><button class="ghost" @onclick="DownloadModelAsync" disabled="@(busy || downloadingModel)">@(downloadingModel ? "正在下载…" : "下载并校验模型")</button></div>
                }
            }
        }
        else
        {
            <label>选择本地 BLIP bundle
                <InputFile OnChange="HandleBundleSelected" multiple accept=".onnx,.txt" disabled="@(busy || uploadingBundle)" />
                <span class="file-name">同时选择 vision encoder、language decoder 和 BERT vocabulary；仅支持与发布 Profile 一致的文件。</span>
            </label>
            <label>Vision encoder 路径<input @bind="visionEncoderPath" placeholder="vision_encoder.onnx" /></label>
            <label>Language decoder 路径<input @bind="languageDecoderPath" placeholder="text_decoder_full_prefix.onnx" /></label>
            <label>Vocabulary 路径<input @bind="vocabularyPath" placeholder="bert-base-uncased-vocab.txt" /></label>
        }
        @if (downloadingModel || uploadingBundle)
        {
            <div class="progress-row"><progress value="@modelProgress" max="1"></progress><span>@modelProgress.ToString("P0")</span></div>
        }

        <label>输入图像
            <InputFile OnChange="HandleImageSelected" accept="image/png,image/jpeg,image/webp" disabled="@busy" />
            <span class="file-name">@(string.IsNullOrWhiteSpace(imageFileName) ? "可上传本地图像；未选择时使用 Release 测试图" : imageFileName)</span>
        </label>
        @if (testImages.Count > 0)
        {
            <label>Release 测试图像
                <select value="@selectedTestImageId" @onchange="HandleTestImageChanged" disabled="@busy">
                    @foreach (VisualTestImage image in testImages) { <option value="@image.Id">@image.FileName · @string.Join(", ", image.Tasks)</option> }
                </select>
            </label>
        }
        @if (downloadingImage)
        {
            <div class="progress-row"><progress value="@imageProgress" max="1"></progress><span>@imageProgress.ToString("P0")</span></div>
        }

        <div class="actions">
            <button class="primary" @onclick="RunAsync" disabled="@(busy || loadingCatalog || uploadingBundle)">@(busy ? "运行中…" : selectedIsClip ? "生成图像 Embedding" : "生成图像描述")</button>
            <button class="ghost" @onclick="Cancel" disabled="@(!busy)">取消</button>
        </div>
        @if (busy) { <div class="progress-row"><progress value="@runProgress" max="1"></progress><span>@runProgress.ToString("P0")</span></div> }
        <p class="run-note">@(selectedIsClip ? "CLIP 当前执行官方图像 Encoder 并返回 512 维归一化 embedding；主库未提供 CLIP BPE tokenizer 时不会伪造文本相似度。" : "当前 BLIP Release Profile 只声明 image captioning。视觉问答和任意指令没有通过该模型合同验证，因此本页不会将提示词问答伪装成可用能力。")</p>
    </section>

    <section class="panel multi-result">
        <div class="panel-title"><div><span class="eyebrow">AUDITABLE RESULT</span><h4>图像与真实生成结果</h4></div><span class="status-tag">@runtimeState</span></div>
        <div class="image-stage">
            @if (!string.IsNullOrWhiteSpace(imagePreview)) { <img src="@imagePreview" alt="多模态输入图像" /> }
            else { <span class="image-empty">上传图像，或运行时自动准备 Release 测试图</span> }
        </div>
        <div class="caption-output">@(string.IsNullOrWhiteSpace(caption) ? statusMessage : caption)</div>
        <div class="evidence-grid">
            <div><small>运行模式</small><b>@runMode</b></div>
            <div><small>模型 / 后端</small><b>@modelEvidence</b></div>
            <div><small>耗时</small><b>@timingEvidence</b></div>
            <div><small>结束原因</small><b>@finishReason</b></div>
            <div><small>图像 SHA256</small><b>@sourceImageSha</b></div>
            <div><small>生成 Identity</small><b>@generationIdentity</b></div>
        </div>
        @if (diagnostics.Count > 0)
        {
            <div class="diagnostic-box">@string.Join("；", diagnostics.Select(item => item.Code + " - " + item.Message))</div>
        }
    </section>
</div>

@code {
    private readonly List<VisualReleaseModel> releaseModels = new();
    private readonly List<VisualTestImage> testImages = new();
    private IReadOnlyList<RuntimeDiagnostic> diagnostics = Array.Empty<RuntimeDiagnostic>();
    private bool useRelease = true;
    private bool loadingCatalog = true;
    private bool downloadingModel;
    private bool uploadingBundle;
    private bool downloadingImage;
    private bool busy;
    private bool lastSucceeded;
    private double modelProgress;
    private double imageProgress;
    private double runProgress;
    private string selectedModelId = string.Empty;
    private string selectedTestImageId = string.Empty;
    private string visionEncoderPath = string.Empty;
    private string languageDecoderPath = string.Empty;
    private string vocabularyPath = string.Empty;
    private string imagePath = string.Empty;
    private string imageFileName = string.Empty;
    private string? imagePreview;
    private string caption = string.Empty;
    private string runtimeState = "等待输入";
    private string statusMessage = "选择模型与图像后开始运行。";
    private string runMode = "未运行";
    private string modelEvidence = "BLIP caption-base · ONNX Runtime CPU";
    private string timingEvidence = "-";
    private string finishReason = "-";
    private string sourceImageSha = "-";
    private string generationIdentity = "-";
    private string? ownedImagePath;
    private string? ownedBundleDirectory;
    private CancellationTokenSource? cancellation;
    private VisualReleaseModel? selectedModel => releaseModels.FirstOrDefault(item => string.Equals(item.Id, selectedModelId, StringComparison.OrdinalIgnoreCase));
    private bool selectedIsClip => selectedModel?.LogicalModelId.Equals("vision-language/clip-vit-b-32", StringComparison.OrdinalIgnoreCase) == true;
    private VisualTestImage? selectedTestImage => testImages.FirstOrDefault(item => string.Equals(item.Id, selectedTestImageId, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            IReadOnlyList<VisualReleaseModel> models = await ReleaseCatalog.GetModelsAsync();
            releaseModels.AddRange(models.Where(model => model.DisplayName.Contains("BLIP", StringComparison.OrdinalIgnoreCase) || model.Task.Contains("caption", StringComparison.OrdinalIgnoreCase) || model.Task.Contains("language", StringComparison.OrdinalIgnoreCase)));
            selectedModelId = releaseModels.FirstOrDefault()?.Id ?? string.Empty;
            IReadOnlyList<VisualTestImage> images = await TestImageCatalog.GetImagesAsync();
            testImages.AddRange(images);
            VisualTestImage? preferred = TestImageCatalog.FindDefault(images, "image-captioning", "BLIP") ?? images.FirstOrDefault(item => string.Equals(item.FileName, "bus.jpg", StringComparison.OrdinalIgnoreCase)) ?? images.FirstOrDefault();
            selectedTestImageId = preferred?.Id ?? string.Empty;
            statusMessage = releaseModels.Count == 0 ? "Release 中没有找到可执行的 BLIP caption bundle。" : "模型目录已加载；首次运行会下载并校验完整 bundle。";
        }
        catch (Exception exception)
        {
            runtimeState = "目录不可用";
            statusMessage = "GitHub Release 目录加载失败：" + exception.Message;
            Activity.Add("multimodal-catalog", statusMessage, "DSAPP-MULTIMODAL-CATALOG-FAILED");
        }
        finally { loadingCatalog = false; await InvokeAsync(StateHasChanged); }
    }

    private void UseRelease() { useRelease = true; statusMessage = "使用发布 bundle；缺少缓存时运行会自动下载。"; }
    private void UseLocal() { useRelease = false; statusMessage = "本地上传当前只接受三个经过相同 BLIP Profile 导出的文件。"; }
    private void HandleModelChanged(ChangeEventArgs args) { selectedModelId = args.Value?.ToString() ?? string.Empty; caption = string.Empty; }
    private void HandleTestImageChanged(ChangeEventArgs args) { selectedTestImageId = args.Value?.ToString() ?? string.Empty; DeleteOwnedImage(); imagePath = string.Empty; imageFileName = selectedTestImage?.FileName ?? string.Empty; imagePreview = null; }

    private async Task DownloadModelAsync()
    {
        if (selectedModel is null || downloadingModel) return;
        downloadingModel = true; modelProgress = 0; statusMessage = "首次使用正在下载完整 BLIP bundle，并逐文件校验 SHA256。";
        try
        {
            await PrepareReleaseBundleAsync(CancellationToken.None);
            statusMessage = "BLIP bundle 已缓存并通过 SHA256 校验。";
        }
        catch (Exception exception) { statusMessage = "模型下载失败：" + exception.Message; Activity.Add("multimodal-model", statusMessage, "DSAPP-MULTIMODAL-DOWNLOAD-FAILED"); }
        finally { downloadingModel = false; }
    }

    private async Task PrepareReleaseBundleAsync(CancellationToken token)
    {
        VisualReleaseModel model = selectedModel ?? throw new InvalidOperationException("未选择 BLIP Release 模型。");
        VisualModelDownloadResult downloaded = await ReleaseCatalog.DownloadAsync(model, new Progress<double>(value => { modelProgress = value; _ = InvokeAsync(StateHasChanged); }), token);
        VisualReleaseFile vision = selectedIsClip ? FindBundleFile(model, "image", "encoder") ?? model.PrimaryFile : FindBundleFile(model, "vision", "encoder") ?? model.PrimaryFile;
        VisualReleaseFile decoder = selectedIsClip ? FindBundleFile(model, "text", "encoder") ?? throw new InvalidDataException("Release bundle 缺少 CLIP text encoder。") : FindBundleFile(model, "decoder") ?? throw new InvalidDataException("Release bundle 缺少 language decoder。");
        VisualReleaseFile? vocabulary = selectedIsClip ? null : model.Files.FirstOrDefault(file => string.Equals(file.Role, "vocabulary", StringComparison.OrdinalIgnoreCase)) ?? FindBundleFile(model, "vocab") ?? throw new InvalidDataException("Release bundle 缺少 vocabulary。");
        visionEncoderPath = ReleaseCatalog.GetCachedFilePath(model, vision);
        languageDecoderPath = ReleaseCatalog.GetCachedFilePath(model, decoder);
        vocabularyPath = vocabulary is null ? string.Empty : ReleaseCatalog.GetCachedFilePath(model, vocabulary);
        ReplaceReleaseModel(downloaded.Model with { Cached = true });
        Activity.Add("multimodal-model", "Downloaded and SHA256-verified " + model.DisplayName, "DSAPP-MULTIMODAL-MODEL-READY");
    }

    private static VisualReleaseFile? FindBundleFile(VisualReleaseModel model, params string[] tokens)
    {
        return model.Files.FirstOrDefault(file => tokens.All(token => (file.AssetName + " " + file.RelativePath).Contains(token, StringComparison.OrdinalIgnoreCase)));
    }

    private void ReplaceReleaseModel(VisualReleaseModel replacement)
    {
        int index = releaseModels.FindIndex(item => string.Equals(item.Id, replacement.Id, StringComparison.OrdinalIgnoreCase));
        if (index >= 0) releaseModels[index] = replacement;
    }

    private async Task HandleBundleSelected(InputFileChangeEventArgs args)
    {
        IReadOnlyList<IBrowserFile> files;
        try { files = args.GetMultipleFiles(3); }
        catch (InvalidOperationException) { statusMessage = "本地 BLIP bundle 必须一次选择三个文件。"; return; }
        IBrowserFile[] models = files.Where(file => string.Equals(Path.GetExtension(file.Name), ".onnx", StringComparison.OrdinalIgnoreCase)).OrderBy(file => file.Size).ToArray();
        IBrowserFile? vocabulary = files.FirstOrDefault(file => string.Equals(Path.GetExtension(file.Name), ".txt", StringComparison.OrdinalIgnoreCase));
        if (files.Count != 3 || models.Length != 2 || vocabulary is null) { statusMessage = "请选择两个 .onnx 文件和一个 .txt vocabulary。"; return; }
        const long maximumFileBytes = 1024L * 1024 * 1024;
        if (files.Any(file => file.Size <= 0 || file.Size > maximumFileBytes)) { statusMessage = "每个 bundle 文件必须大于 0 且不超过 1 GB。"; return; }

        uploadingBundle = true; modelProgress = 0; DeleteOwnedBundle();
        string directory = Path.Combine(Path.GetTempPath(), "DeploySharpApp", "multimodal-bundles", Guid.NewGuid().ToString("N"));
        Directory.CreateDirectory(directory);
        try
        {
            long total = files.Sum(file => file.Size); long completed = 0;
            var paths = new Dictionary<IBrowserFile, string>();
            foreach (IBrowserFile file in files)
            {
                string target = Path.Combine(directory, Path.GetFileName(file.Name));
                await using Stream source = file.OpenReadStream(maximumFileBytes);
                await using var destination = new FileStream(target, FileMode.CreateNew, FileAccess.Write, FileShare.None, 128 * 1024, useAsync: true);
                byte[] buffer = new byte[128 * 1024]; int read;
                while ((read = await source.ReadAsync(buffer.AsMemory())) != 0)
                {
                    await destination.WriteAsync(buffer.AsMemory(0, read)); completed += read; modelProgress = completed / (double)total; await InvokeAsync(StateHasChanged);
                }
                await destination.FlushAsync(); paths[file] = target;
            }
            IBrowserFile vision = models.FirstOrDefault(file => file.Name.Contains("vision", StringComparison.OrdinalIgnoreCase)) ?? models[0];
            IBrowserFile decoder = models.FirstOrDefault(file => file.Name.Contains("decoder", StringComparison.OrdinalIgnoreCase)) ?? models[1];
            visionEncoderPath = paths[vision]; languageDecoderPath = paths[decoder]; vocabularyPath = paths[vocabulary]; ownedBundleDirectory = directory;
            statusMessage = "本地 bundle 已上传；Worker 会按 BLIP Profile 的尺寸与 SHA256 合同复验。";
            Activity.Add("multimodal-model", "Uploaded local BLIP bundle", "DSAPP-MULTIMODAL-LOCAL-BUNDLE");
        }
        catch (Exception exception)
        {
            DeleteDirectoryFiles(directory); statusMessage = "本地 bundle 上传失败：" + exception.Message; Activity.Add("multimodal-model", statusMessage, "DSAPP-MULTIMODAL-UPLOAD-FAILED");
        }
        finally { uploadingBundle = false; }
    }

    private async Task HandleImageSelected(InputFileChangeEventArgs args)
    {
        IBrowserFile file = args.File;
        const long maximumBytes = 20L * 1024 * 1024;
        if (file.Size <= 0 || file.Size > maximumBytes) { statusMessage = "图像必须大于 0 且不超过 20 MB。"; return; }
        DeleteOwnedImage();
        string directory = Path.Combine(Path.GetTempPath(), "DeploySharpApp", "multimodal-images"); Directory.CreateDirectory(directory);
        string target = Path.Combine(directory, Guid.NewGuid().ToString("N") + Path.GetExtension(file.Name));
        try
        {
            await using Stream source = file.OpenReadStream(maximumBytes);
            await using var destination = new FileStream(target, FileMode.CreateNew, FileAccess.Write, FileShare.None, 128 * 1024, useAsync: true);
            await source.CopyToAsync(destination); await destination.FlushAsync();
            ownedImagePath = target; imagePath = target; imageFileName = Path.GetFileName(file.Name); selectedTestImageId = string.Empty;
            await SetImagePreviewAsync(target, string.IsNullOrWhiteSpace(file.ContentType) ? "image/*" : file.ContentType);
            statusMessage = "本地图像已准备。";
        }
        catch (Exception exception) { if (File.Exists(target)) File.Delete(target); statusMessage = "图像上传失败：" + exception.Message; }
    }

    private async Task PrepareTestImageAsync(CancellationToken token)
    {
        VisualTestImage image = selectedTestImage ?? throw new InvalidOperationException("没有可用的 Release 测试图像，请上传本地图像。");
        downloadingImage = true; imageProgress = 0;
        try
        {
            VisualTestImageDownloadResult downloaded = await TestImageCatalog.DownloadAsync(image, new Progress<double>(value => { imageProgress = value; _ = InvokeAsync(StateHasChanged); }), token);
            imagePath = downloaded.Path; imageFileName = downloaded.Image.FileName; await SetImagePreviewAsync(downloaded.Path, downloaded.Image.MediaType);
            Activity.Add("multimodal-image", "Downloaded and SHA256-verified " + image.FileName, "DSAPP-MULTIMODAL-IMAGE-READY");
        }
        finally { downloadingImage = false; }
    }

    private async Task SetImagePreviewAsync(string path, string mediaType)
    {
        byte[] bytes = await File.ReadAllBytesAsync(path);
        imagePreview = "data:" + mediaType + ";base64," + Convert.ToBase64String(bytes);
    }

    private async Task RunAsync()
    {
        if (busy) return;
        busy = true; lastSucceeded = false; caption = string.Empty; diagnostics = Array.Empty<RuntimeDiagnostic>(); runProgress = 0; runtimeState = "准备中"; statusMessage = "正在准备模型与图像…";
        cancellation = new CancellationTokenSource(TimeSpan.FromMinutes(30));
        try
        {
            if (useRelease) await PrepareReleaseBundleAsync(cancellation.Token);
            if (string.IsNullOrWhiteSpace(imagePath) || !File.Exists(imagePath)) await PrepareTestImageAsync(cancellation.Token);
            bool clip = useRelease && selectedIsClip;
            if (!File.Exists(visionEncoderPath) || !File.Exists(languageDecoderPath) || !clip && !File.Exists(vocabularyPath)) throw new FileNotFoundException(clip ? "CLIP bundle 不完整，请下载完整 Release 模型。" : "BLIP bundle 不完整，请下载 Release 模型或提供三个本地文件。");

            var options = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["executionMode"] = "worker", ["operation"] = AppOperationKind.Multimodal.ToString(), ["multimodalProfile"] = clip ? "clip-vit-b-32-image-embedding" : "blip-caption-base", [clip ? "textEncoderPath" : "languageDecoderPath"] = languageDecoderPath, ["stream"] = bool.TrueString
            };
            if (!clip) options["vocabularyPath"] = vocabularyPath;
            string modelId = useRelease && selectedModel is not null ? selectedModel.LogicalModelId : "local/blip-caption-base";
            var request = new ModelRunRequest(AppOperationKind.Multimodal, modelId, "deploysharp.backend.onnxruntime", device: "cpu", inputPath: imagePath, options: options, timeout: TimeSpan.FromMinutes(30), modelPath: visionEncoderPath, modelFormat: "onnx");
            var textProgress = new Progress<string>(delta => { caption += delta; _ = InvokeAsync(StateHasChanged); });
            ModelRunResult result = await Service.RunStreamingAsync(request, new Progress<double>(value => { runProgress = value; _ = InvokeAsync(StateHasChanged); }), textProgress, cancellation.Token);
            diagnostics = result.Diagnostics;
            runMode = result.RunMode.ToString(); runtimeState = result.Succeeded ? "Available" : result.RuntimeStatus?.State.ToString() ?? result.ErrorCode.ToString(); statusMessage = result.Message;
            timingEvidence = $"前处理 {result.PreprocessMs:F1} ms · 推理 {result.InferenceMs:F1} ms · 后处理 {result.PostprocessMs:F1} ms";
            modelEvidence = (selectedModel?.DisplayName ?? "本地 BLIP bundle") + " · ONNX Runtime CPU";
            if (result.Succeeded) ParseOutput(result.Output);
            else caption = result.Message;
            lastSucceeded = result.Succeeded;
            Activity.Add("multimodal", result.Message, result.Diagnostics.FirstOrDefault()?.Code);
        }
        catch (OperationCanceledException) { runtimeState = "Cancelled"; statusMessage = "多模态操作已取消。"; caption = statusMessage; Activity.Add("multimodal", statusMessage, "DSAPP-WEB-CANCELLED"); }
        catch (Exception exception) { runtimeState = "Unavailable"; statusMessage = exception.Message; caption = statusMessage; Activity.Add("multimodal", statusMessage, "DSAPP-MULTIMODAL-FAILED"); }
        finally { cancellation.Dispose(); cancellation = null; busy = false; runProgress = lastSucceeded ? 1 : runProgress; }
    }

    private void ParseOutput(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return;
        try
        {
            using System.Text.Json.JsonDocument document = System.Text.Json.JsonDocument.Parse(json);
            System.Text.Json.JsonElement root = document.RootElement;
            string task = root.TryGetProperty("task", out System.Text.Json.JsonElement taskElement) ? taskElement.GetString() ?? string.Empty : string.Empty;
            if (task.Equals("vision-language-image-embedding", StringComparison.OrdinalIgnoreCase))
            {
                int dimension = root.GetProperty("dimension").GetInt32();
                caption = "CLIP 图像 embedding 已生成：" + dimension + " 维，SHA256 " + ShortHash(root.GetProperty("embeddingSha256").GetString());
                finishReason = "embedding";
                generationIdentity = ShortHash(root.GetProperty("artifactIdentity").GetString());
            }
            else
            {
                caption = root.GetProperty("text").GetString() ?? caption;
                finishReason = root.GetProperty("finishReason").GetString() ?? "-";
                generationIdentity = ShortHash(root.GetProperty("generationIdentity").GetString());
            }
            sourceImageSha = ShortHash(root.GetProperty("sourceImageSha256").GetString());
        }
        catch (Exception exception) when (exception is System.Text.Json.JsonException || exception is InvalidOperationException || exception is KeyNotFoundException) { diagnostics = diagnostics.Concat(new[] { new RuntimeDiagnostic("DSAPP-MULTIMODAL-RESULT-INVALID", DiagnosticSeverity.Warning, "Worker 返回的结构化结果无法解析。", details: new Dictionary<string, string> { ["technicalDetail"] = exception.Message }) }).ToArray(); }
    }

    private static string ShortHash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Length <= 20 ? value : value[..20] + "…";
    private void Cancel() => cancellation?.Cancel();
    private void DeleteOwnedImage() { if (!string.IsNullOrWhiteSpace(ownedImagePath) && File.Exists(ownedImagePath)) { try { File.Delete(ownedImagePath); } catch (IOException) { } catch (UnauthorizedAccessException) { } } ownedImagePath = null; }
    private void DeleteOwnedBundle() { if (!string.IsNullOrWhiteSpace(ownedBundleDirectory)) DeleteDirectoryFiles(ownedBundleDirectory); ownedBundleDirectory = null; }
    private static void DeleteDirectoryFiles(string directory) { if (!Directory.Exists(directory)) return; try { foreach (string file in Directory.GetFiles(directory)) File.Delete(file); Directory.Delete(directory); } catch (IOException) { } catch (UnauthorizedAccessException) { } }
    public void Dispose() { cancellation?.Cancel(); cancellation?.Dispose(); DeleteOwnedImage(); DeleteOwnedBundle(); }
}
